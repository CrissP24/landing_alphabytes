---
import * as iconos from 'simple-icons';
import { TECNOLOGIAS } from '../data/site';

const luminancia = (hex: string) => {
  const [r, g, b] = [0, 2, 4].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};

const colorHover = (hex?: string) => (hex && luminancia(hex) > 0.07 ? `#${hex}` : 'var(--lima)');

const grupos = TECNOLOGIAS.map((g) => ({
  ...g,
  items: g.items.map((t) => {
    const icono = t.icono ? (iconos as Record<string, any>)[t.icono] : undefined;
    return { ...t, path: icono?.path as string | undefined, color: colorHover(icono?.hex) };
  }),
}));
---

<section class="seccion" id="tecnologias" aria-labelledby="tec-titulo">
  <div class="contenedor">
    <header class="cabecera revelar">
      <p class="etiqueta">// Tecnologías</p>
      <h2 id="tec-titulo">Herramientas que <span class="acento">dominamos</span></h2>
      <p>Elegimos la tecnología según tu proyecto, no al revés. Así obtienes software estable, rápido y fácil de mantener.</p>
    </header>

    <div class="grupos">
      {grupos.map((g, i) => (
        <div class="grupo revelar" style={`--retraso: ${i * 0.06}s`}>
          <h3>{g.categoria}</h3>
          <ul>
            {g.items.map((t) => (
              <li class="chip" style={`--color: ${t.color}`}>
                {t.path ? (
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={t.path} /></svg>
                ) : (
                  <span class="chip__sigla" aria-hidden="true">{t.sigla}</span>
                )}
                {t.nombre}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grupos {
    display: grid;
    gap: 16px;
  }

  .grupo {
    padding: 24px;
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    background: var(--tinta-2);
  }

  .grupo h3 {
    margin-bottom: 18px;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .grupo ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 14px;
    border: 1px solid var(--borde);
    border-radius: 10px;
    background: var(--tinta);
    font-size: 15px;
    font-weight: 500;
    color: var(--niebla);
    transition:
      border-color 0.25s,
      color 0.25s,
      translate 0.25s var(--ease);
  }

  .chip svg,
  .chip__sigla {
    color: var(--gris);
    transition: color 0.25s;
  }

  .chip__sigla {
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
  }

  .chip:hover {
    translate: 0 -2px;
    border-color: var(--color);
    color: var(--blanco);
  }

  .chip:hover svg,
  .chip:hover .chip__sigla {
    color: var(--color);
  }

  @media (min-width: 768px) {
    .grupos {
      grid-template-columns: repeat(6, 1fr);
    }

    .grupo {
      grid-column: span 3;
    }

    .grupo:nth-child(n + 3) {
      grid-column: span 2;
    }
  }
</style>
