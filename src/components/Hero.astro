---
import Icon from './Icon.astro';
import WaButton from './WaButton.astro';
import { TECNOLOGIAS_HERO, SITE } from '../data/site';
---

<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="hero__grilla" aria-hidden="true"></div>
  <div class="contenedor hero__fila">
    <div class="hero__texto">
      <p class="etiqueta revelar">// Desarrollo de software a medida</p>
      <h1 id="hero-titulo" class="revelar" style="--retraso: 0.08s">
        Convertimos tus ideas en <span class="acento">software</span> que hace crecer tu negocio.
      </h1>
      <p class="hero__sub revelar" style="--retraso: 0.16s">
        Páginas web, aplicaciones móviles, sistemas de escritorio, auditorías y soporte técnico. Todo en un solo equipo.
      </p>
      <div class="hero__botones revelar" style="--retraso: 0.24s">
        <WaButton clave="general">Hablemos por WhatsApp</WaButton>
        <a href="#servicios" class="btn btn--borde">
          Ver servicios
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <p class="hero__nota revelar" style="--retraso: 0.32s">
        <Icon name="pin" size={16} />
        {SITE.ciudad}, {SITE.provincia} · Atención presencial y remota
      </p>
    </div>

    <div class="editor revelar" style="--retraso: 0.2s" aria-hidden="true">
      <span class="pixel editor__px editor__px--1"></span>
      <span class="pixel editor__px editor__px--2"></span>
      <span class="pixel editor__px editor__px--3"></span>
      <div class="editor__barra">
        <span></span><span></span><span></span>
        <p>alphabytes / proyecto.ts</p>
      </div>
      <div class="editor__cuerpo">
        <ol class="editor__codigo">
          <li><span class="k">import</span> {'{'} <span class="v">Negocio</span> {'}'} <span class="k">from</span> <span class="s">'./tu-idea'</span>;</li>
          <li>&nbsp;</li>
          <li><span class="k">const</span> <span class="v">proyecto</span> = <span class="f">crear</span>({'{'}</li>
          <li>&nbsp;&nbsp;tipo: <span class="s">'web · app · sistema'</span>,</li>
          <li>&nbsp;&nbsp;diseño: <span class="s">'moderno'</span>,</li>
          <li>&nbsp;&nbsp;rendimiento: <span class="n">100</span>,</li>
          <li>&nbsp;&nbsp;soporte: <span class="k">true</span>,</li>
          <li>{'}'});</li>
          <li>&nbsp;</li>
          <li><span class="v">Negocio</span>.<span class="f">crecer</span>(proyecto);<span class="cursor"></span></li>
        </ol>
        <div class="editor__sello">
          <svg viewBox="0 0 100 100" width="88" height="88">
            <rect width="100" height="100" rx="24" fill="#5B4BFF"></rect>
            <path d="M71 30 C64 54 57 71 42 71 C30 71 25 62 25 51 C25 39 32 31 43 31 C56 31 61 55 74 71" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" stroke="#FFFFFF"></path>
            <rect x="76" y="19" width="10" height="10" rx="2" fill="#C6F432"></rect>
          </svg>
        </div>
      </div>
      <div class="editor__estado">
        <span><i></i> compilado sin errores</span>
        <span>UTF-8 · TS</span>
      </div>
    </div>
  </div>

  <div class="contenedor">
    <ul class="hero__tec revelar" aria-label="Tecnologías principales">
      {TECNOLOGIAS_HERO.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(48px, 8vw, 96px) 0 clamp(56px, 8vw, 88px);
    margin-top: calc(var(--header) * -1);
    padding-top: calc(var(--header) + clamp(40px, 7vw, 96px));
    overflow: hidden;
  }

  .hero__grilla {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(233 235 242 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(233 235 242 / 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero__fila {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .hero h1 {
    margin-top: 20px;
    font-size: clamp(38px, 6.4vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .hero__sub {
    margin-top: 24px;
    max-width: 560px;
    font-size: clamp(17px, 2vw, 19px);
    color: var(--gris);
  }

  .hero__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__nota {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-size: 14px;
    color: var(--gris);
  }

  .hero__nota :global(svg) {
    color: var(--lima);
  }

  .editor {
    position: relative;
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    background: var(--tinta-2);
    box-shadow: var(--sombra);
    font-family: var(--mono);
    font-size: 13px;
  }

  .editor__barra {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--borde);
  }

  .editor__barra span {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--borde);
  }

  .editor__barra span:first-child {
    background: var(--indigo);
  }

  .editor__barra span:nth-child(2) {
    background: var(--lima);
  }

  .editor__barra p {
    margin-left: 10px;
    color: var(--gris);
    font-size: 12px;
  }

  .editor__cuerpo {
    position: relative;
    padding: 22px 18px 26px 0;
    overflow: hidden;
  }

  .editor__codigo {
    margin: 0;
    padding-left: 52px;
    color: var(--niebla);
    line-height: 1.9;
    counter-reset: linea;
    white-space: nowrap;
  }

  .editor__codigo li {
    position: relative;
    list-style: none;
    counter-increment: linea;
  }

  .editor__codigo li::before {
    content: counter(linea);
    position: absolute;
    left: -38px;
    width: 22px;
    text-align: right;
    color: #4c5574;
  }

  .k {
    color: var(--indigo-claro);
  }

  .s {
    color: var(--lima);
  }

  .f {
    color: #7dd3fc;
  }

  .v {
    color: var(--blanco);
    font-weight: 500;
  }

  .n {
    color: #fca5a5;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    margin-left: 4px;
    vertical-align: -3px;
    background: var(--lima);
    animation: parpadeo 1.1s steps(1) infinite;
  }

  .editor__sello {
    position: absolute;
    right: 22px;
    bottom: 22px;
    filter: drop-shadow(0 18px 30px rgb(91 75 255 / 0.45));
    animation: flotar 6s ease-in-out infinite;
  }

  .editor__estado {
    display: flex;
    justify-content: space-between;
    padding: 10px 18px;
    border-top: 1px solid var(--borde);
    color: var(--gris);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .editor__estado i {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 2px;
    background: var(--whatsapp);
  }

  .editor__px {
    z-index: 1;
    animation: flotar 5s ease-in-out infinite;
  }

  .editor__px--1 {
    top: -18px;
    right: 18%;
  }

  .editor__px--2 {
    width: 14px;
    height: 14px;
    bottom: 26%;
    left: -24px;
    animation-delay: -2s;
  }

  .editor__px--3 {
    width: 7px;
    height: 7px;
    top: 30%;
    right: -18px;
    background: var(--indigo);
    animation-delay: -3.5s;
  }

  .hero__tec {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: 28px;
    border-top: 1px solid var(--borde);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .hero__tec li:not(:last-child)::after {
    content: '·';
    margin: 0 12px;
    color: var(--lima);
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  @keyframes flotar {
    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 420px) {
    .editor__codigo {
      font-size: 11.5px;
    }

    .editor__sello svg {
      width: 64px;
      height: 64px;
    }
  }

  @media (min-width: 1024px) {
    .hero__fila {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }

    .editor {
      font-size: 14px;
    }
  }
</style>
