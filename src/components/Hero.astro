---
import Icon from './Icon.astro';
import WaButton from './WaButton.astro';
import { TECNOLOGIAS_HERO, SITE } from '../data/site';
import { asset } from '../lib/url';

const titulo = 'Convertimos tus ideas en *software* que hace crecer tu negocio.'.split(' ');

const codigo = [
  '<span class="k">import</span> { <span class="v">Negocio</span> } <span class="k">from</span> <span class="s">\'./tu-idea\'</span>;',
  '',
  '<span class="k">const</span> <span class="v">proyecto</span> = <span class="f">crear</span>({',
  '  tipo: <span class="s">\'web · app · sistema\'</span>,',
  '  diseño: <span class="s">\'a tu medida\'</span>,',
  '  rendimiento: <span class="n">100</span>,',
  '  soporte: <span class="k">true</span>,',
  '});',
  '',
  '<span class="k">await</span> <span class="v">Negocio</span>.<span class="f">crecer</span>(proyecto);',
];
---

<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="hero__grilla" aria-hidden="true"></div>
  <div class="hero__halo" aria-hidden="true"></div>

  <div class="contenedor hero__fila">
    <div class="hero__texto">
      <p class="hero__chip revelar">
        <span class="hero__punto"></span>
        <span class="mono">Desarrollo de software a medida</span>
        <span class="hero__sep"></span>
        <span>{SITE.ciudad}, {SITE.provincia}</span>
      </p>

      <h1 id="hero-titulo" class="hero__titulo">
        {titulo.map((palabra, i) => {
          const acento = palabra.startsWith('*');
          return (
            <>
              <span class="palabra">
                <span class:list={[acento && 'acento']} style={`--i: ${i}`}>{palabra.replaceAll('*', '')}</span>
              </span>{' '}
            </>
          );
        })}
      </h1>

      <p class="hero__sub revelar" style="--retraso: 0.5s">
        Páginas web, aplicaciones móviles, sistemas de escritorio, auditorías y soporte técnico. Un solo equipo que
        entiende tu negocio y lo lleva a lo digital.
      </p>

      <div class="hero__botones revelar" style="--retraso: 0.6s">
        <WaButton clave="general">Hablemos por WhatsApp</WaButton>
        <a href={asset('cotizador')} class="btn btn--borde">
          Arma tu proyecto
          <Icon name="arrow" size={18} />
        </a>
      </div>

      <ul class="hero__datos revelar" style="--retraso: 0.7s">
        <li><Icon name="check" size={15} /> Cotización sin costo</li>
        <li><Icon name="check" size={15} /> Atención presencial y remota</li>
        <li><Icon name="check" size={15} /> Soporte después de la entrega</li>
      </ul>
    </div>

    <div class="escena revelar" style="--retraso: 0.25s" aria-hidden="true">
      <span class="pixel escena__px escena__px--1"></span>
      <span class="pixel escena__px escena__px--2"></span>
      <span class="pixel escena__px escena__px--3"></span>

      <div class="editor siempre-oscuro">
        <div class="editor__barra">
          <span class="editor__luces"><i></i><i></i><i></i></span>
          <span class="editor__tab editor__tab--activa">proyecto.ts</span>
          <span class="editor__tab">cliente.json</span>
        </div>
        <div class="editor__cuerpo">
          <ol class="editor__codigo">
            {codigo.map((linea, n) => (
              <li style={`--n: ${n}`}>
                <span class="editor__linea" set:html={linea || '&nbsp;'} />
                {n === codigo.length - 1 && <span class="cursor"></span>}
              </li>
            ))}
          </ol>
          <div class="editor__sello">
            <svg viewBox="0 0 100 100" width="84" height="84">
              <rect width="100" height="100" rx="24" fill="#5B4BFF"></rect>
              <path d="M71 30 C64 54 57 71 42 71 C30 71 25 62 25 51 C25 39 32 31 43 31 C56 31 61 55 74 71" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" stroke="#FFFFFF"></path>
              <rect x="76" y="19" width="10" height="10" rx="2" fill="#C6F432"></rect>
            </svg>
          </div>
        </div>
        <div class="editor__estado">
          <span class="estado estado--compilando"><i></i>compilando…</span>
          <span class="estado estado--listo"><i></i>compilado sin errores</span>
          <span>UTF-8 · TypeScript</span>
        </div>
      </div>

      <div class="aviso-deploy">
        <span class="aviso-deploy__icono"><Icon name="check" size={16} /></span>
        <div>
          <p>Proyecto publicado</p>
          <span>tuempresa.com · listo en producción</span>
        </div>
      </div>
    </div>
  </div>

  <div class="contenedor">
    <div class="tec revelar" style="--retraso: 0.8s">
      <p class="tec__titulo">Stack</p>
      <div class="tec__pista">
        <ul class="tec__lista">
          {TECNOLOGIAS_HERO.map((t) => <li>{t}</li>)}
        </ul>
        <ul class="tec__lista" aria-hidden="true">
          {TECNOLOGIAS_HERO.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(var(--header) * -1);
    padding: calc(var(--header) + clamp(40px, 7vw, 88px)) 0 clamp(48px, 6vw, 72px);
    overflow: hidden;
  }

  .hero__grilla {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--rejilla) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rejilla) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 75% 65% at 70% 35%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 70% 35%, #000 25%, transparent 75%);
    pointer-events: none;
  }

  .hero__halo {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60vw;
    max-width: 820px;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(91 75 255 / 0.16), transparent 60%);
    pointer-events: none;
  }

  .hero__fila {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .hero__chip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    font-size: 13px;
    color: var(--texto-2);
  }

  .hero__chip .mono {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--titulo);
  }

  .hero__punto {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--lima);
  }

  .hero__punto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--lima);
    animation: latido 2.4s ease-out infinite;
  }

  .hero__sep {
    width: 1px;
    height: 12px;
    background: var(--borde-fuerte);
  }

  .hero__titulo {
    margin-top: 26px;
    font-size: clamp(40px, 6.2vw, 74px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .palabra {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }

  .palabra > span {
    display: inline-block;
  }

  .js .palabra > span {
    animation: subir 0.9s var(--ease) both;
    animation-delay: calc(0.1s + var(--i) * 0.045s);
  }

  .hero__sub {
    margin-top: 28px;
    max-width: 540px;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--texto-2);
  }

  .hero__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 28px;
    font-size: 14px;
    color: var(--texto-2);
  }

  .hero__datos li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero__datos :global(svg) {
    color: var(--acento);
  }

  .escena {
    position: relative;
  }

  .editor {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    background: var(--bg-2);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.02),
      0 40px 80px -30px rgb(11 15 26 / 0.55);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--texto);
  }

  .editor__barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    height: 46px;
    border-bottom: 1px solid var(--borde);
    background: var(--bg);
  }

  .editor__luces {
    display: inline-flex;
    gap: 6px;
    margin-right: 10px;
  }

  .editor__luces i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--borde-fuerte);
  }

  .editor__luces i:first-child {
    background: var(--indigo);
  }

  .editor__luces i:nth-child(2) {
    background: var(--lima);
  }

  .editor__tab {
    padding: 6px 12px;
    border-radius: 7px;
    font-size: 12px;
    color: var(--texto-3);
  }

  .editor__tab--activa {
    background: var(--bg-3);
    color: var(--texto);
  }

  .editor__cuerpo {
    position: relative;
    padding: 22px 18px 26px 0;
    overflow: hidden;
  }

  .editor__codigo {
    margin: 0;
    padding-left: 52px;
    line-height: 1.95;
    white-space: pre;
    counter-reset: linea;
  }

  .editor__codigo li {
    position: relative;
    display: flex;
    list-style: none;
    counter-increment: linea;
  }

  .editor__codigo li::before {
    content: counter(linea);
    position: absolute;
    left: -38px;
    width: 22px;
    text-align: right;
    color: #4c5574;
  }

  .js .escena.visible .editor__linea {
    animation: escribir 0.5s steps(28, end) both;
    animation-delay: calc(0.5s + var(--n) * 0.16s);
  }

  .js .escena:not(.visible) .editor__linea {
    clip-path: inset(0 100% 0 0);
  }

  .editor__codigo :global(.k) {
    color: #9a90ff;
  }

  .editor__codigo :global(.s) {
    color: var(--lima);
  }

  .editor__codigo :global(.f) {
    color: #7dd3fc;
  }

  .editor__codigo :global(.v) {
    color: #ffffff;
    font-weight: 500;
  }

  .editor__codigo :global(.n) {
    color: #fca5a5;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    margin: 6px 0 0 4px;
    background: var(--lima);
    animation: parpadeo 1.1s steps(1) infinite;
  }

  .editor__sello {
    position: absolute;
    right: 22px;
    bottom: 22px;
    filter: drop-shadow(0 18px 30px rgb(91 75 255 / 0.45));
    animation: flotar 6s ease-in-out infinite;
  }

  .editor__estado {
    position: relative;
    display: flex;
    justify-content: flex-end;
    padding: 10px 18px;
    border-top: 1px solid var(--borde);
    color: var(--texto-2);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .estado {
    position: absolute;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .estado i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
  }

  .estado--compilando i {
    background: #fbbf24;
    animation: parpadeo 0.8s steps(1) infinite;
  }

  .estado--listo i {
    background: var(--whatsapp);
  }

  .js .escena.visible .estado--compilando {
    animation: ocultar 0.01s 2.4s both;
  }

  .js .escena.visible .estado--listo {
    animation: mostrar 0.3s 2.4s both;
  }

  .js .escena:not(.visible) .estado--listo {
    opacity: 0;
  }

  .aviso-deploy {
    position: absolute;
    left: -28px;
    bottom: -48px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px 12px 12px;
    border: 1px solid var(--borde);
    border-radius: 14px;
    background: var(--bg-2);
    box-shadow: var(--sombra);
  }

  .js .escena.visible .aviso-deploy {
    animation: aparecer 0.7s var(--ease) 2.6s both;
  }

  .js .escena:not(.visible) .aviso-deploy {
    opacity: 0;
  }

  .aviso-deploy__icono {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--lima);
    color: var(--tinta);
  }

  .aviso-deploy p {
    font-size: 14px;
    font-weight: 600;
    color: var(--titulo);
  }

  .aviso-deploy span:not(.aviso-deploy__icono) {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--texto-2);
  }

  .escena__px {
    z-index: 1;
    animation: flotar 5s ease-in-out infinite;
  }

  .escena__px--1 {
    top: -18px;
    right: 18%;
  }

  .escena__px--2 {
    width: 14px;
    height: 14px;
    top: 34%;
    left: -24px;
    animation-delay: -2s;
  }

  .escena__px--3 {
    width: 7px;
    height: 7px;
    top: 26%;
    right: -18px;
    background: var(--indigo);
    animation-delay: -3.5s;
  }

  .tec {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: clamp(64px, 8vw, 96px);
    padding-top: 26px;
    border-top: 1px solid var(--borde);
  }

  .tec__titulo {
    flex: none;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .tec__pista {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .tec__lista {
    display: flex;
    flex: none;
    animation: deslizar 32s linear infinite;
  }

  .tec__pista:hover .tec__lista {
    animation-play-state: paused;
  }

  .tec__lista li {
    display: flex;
    align-items: center;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-2);
    white-space: nowrap;
  }

  .tec__lista li::after {
    content: '';
    width: 5px;
    height: 5px;
    margin: 0 22px;
    border-radius: 1px;
    background: var(--borde-fuerte);
  }

  @keyframes subir {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes escribir {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes latido {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  @keyframes flotar {
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes ocultar {
    to {
      opacity: 0;
    }
  }

  @keyframes mostrar {
    from {
      opacity: 0;
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }

  @keyframes deslizar {
    to {
      transform: translateX(-100%);
    }
  }

  @media (max-width: 1023px) {
    .aviso-deploy {
      left: calc(16px - var(--gutter));
    }
  }

  @media (max-width: 520px) {
    .hero__sep,
    .hero__chip > span:last-child {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero__botones :global(.btn) {
      flex: 1 1 auto;
    }

    .editor__codigo {
      font-size: 11.5px;
    }

    .editor__tab:not(.editor__tab--activa) {
      display: none;
    }

    .editor__sello svg {
      width: 60px;
      height: 60px;
    }

    .aviso-deploy {
      left: 12px;
    }
  }

  @media (max-width: 380px) {
    .hero__chip {
      gap: 8px;
      padding-right: 12px;
    }

    .hero__chip .mono {
      letter-spacing: 0.04em;
    }

    .editor__codigo {
      padding-left: 40px;
      font-size: 10.5px;
    }

    .editor__codigo li::before {
      left: -30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tec__pista {
      mask-image: none;
      -webkit-mask-image: none;
    }

    .tec__lista {
      flex-wrap: wrap;
      row-gap: 8px;
    }

    .tec__lista[aria-hidden] {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .hero__fila {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 56px;
    }

    .editor {
      font-size: 13.5px;
    }
  }
</style>
