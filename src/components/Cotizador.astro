---
import Icon from './Icon.astro';
import { asset } from '../lib/url';
import { PASOS, SOLUCIONES } from '../data/cotizador';

const total = PASOS.length;
---

<div class="cotizador">
  <form class="asistente" id="asistente" novalidate>
    <div class="asistente__barra">
      <span class="asistente__luces" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mono">cotizador — alphabytes</span>
      <span class="asistente__contador mono" aria-live="polite">
        <span data-num>1</span>/{total}
      </span>
    </div>

    <ol class="progreso-pasos" aria-hidden="true">
      {PASOS.map((p, i) => <li data-segmento={i}><span>{p.etiqueta}</span></li>)}
    </ol>

    {PASOS.map((paso, i) => (
      <fieldset class="paso" data-paso={i} data-id={paso.id} hidden={i !== 0}>
        <legend class="sr-only">{paso.titulo}</legend>
        <p class="paso__prompt mono" aria-hidden="true">
          <span class="paso__signo">?</span> paso {String(i + 1).padStart(2, '0')} · {paso.etiqueta}
          {paso.requerido && <span class="paso__req">requerido</span>}
        </p>
        <h2 class="paso__titulo" tabindex="-1">{paso.titulo}</h2>
        <p class="paso__ayuda">{paso.ayuda}</p>

        {(paso.tipo === 'unica' || paso.tipo === 'multiple') && (
          <>
            {paso.id === 'soluciones' && <p class="sugerencia" data-recomendacion hidden></p>}
            <div class:list={['opciones', paso.opciones!.some((o) => o.icono) && 'opciones--grandes']}>
              {paso.opciones!.map((o) => (
                <label class="op" data-op={o.id}>
                  <input type={paso.tipo === 'unica' ? 'radio' : 'checkbox'} name={paso.id} value={o.id} />
                  <span class="op__caja">
                    {o.icono && <span class="op__icono"><Icon name={o.icono} size={20} /></span>}
                    <span class="op__texto">
                      <span class="op__titulo">{o.texto}</span>
                      {o.detalle && <span class="op__detalle">{o.detalle}</span>}
                    </span>
                    <span class="op__marca" aria-hidden="true"><Icon name="check" size={13} /></span>
                    <span class="op__sugerido">{paso.id === 'soluciones' ? 'Recomendado' : 'Sugerido'}</span>
                  </span>
                </label>
              ))}
            </div>
          </>
        )}

        {paso.tipo === 'funciones' && (
          <>
            <div class="funciones__acciones">
              <button type="button" class="btn btn--borde btn--sm" data-marcar-sugeridas>
                <Icon name="check" size={16} /> Marcar las sugeridas
              </button>
            </div>
            {SOLUCIONES.map((s) => (
              <div class="grupo-f" data-solucion={s.id} hidden>
                <h3 class="grupo-f__titulo"><Icon name={s.icono!} size={16} /> {s.texto}</h3>
                <div class="opciones">
                  {s.funciones.map((f) => (
                    <label class="op op--compacta" data-op={f.id}>
                      <input type="checkbox" name="funciones" value={f.id} />
                      <span class="op__caja">
                        <span class="op__texto"><span class="op__titulo">{f.texto}</span></span>
                        <span class="op__marca" aria-hidden="true"><Icon name="check" size={13} /></span>
                        <span class="op__sugerido">Sugerido</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </>
        )}

        {paso.tipo === 'contacto' && (
          <div class="campos">
            <div class="campo campo--ancho">
              <label for="c-nombre">Nombre <span class="obligatorio">*</span></label>
              <input id="c-nombre" name="nombre" type="text" autocomplete="name" placeholder="¿Cómo te llamas?" required minlength="2" />
            </div>
            <div class="campo">
              <label for="c-empresa">Negocio o empresa</label>
              <input id="c-empresa" name="empresa" type="text" autocomplete="organization" placeholder="Opcional" />
            </div>
            <div class="campo">
              <label for="c-ciudad">Ciudad</label>
              <input id="c-ciudad" name="ciudad" type="text" autocomplete="address-level2" placeholder="Opcional" />
            </div>
            <div class="campo campo--ancho">
              <label for="c-detalles">¿Algo más que debamos saber?</label>
              <textarea id="c-detalles" name="detalles" rows="4" placeholder="Por ejemplo: cómo trabajas hoy, qué problema quieres resolver o una página que te guste como referencia."></textarea>
            </div>
          </div>
        )}

        {paso.tipo === 'revision' && (
          <div class="revision">
            <dl class="resumen" data-resumen></dl>
            <div class="vista">
              <p class="vista__titulo mono">
                <Icon name="whatsapp" size={14} /> Vista previa del mensaje
              </p>
              <pre class="vista__burbuja" data-vista></pre>
            </div>
            <p class="revision__nota">
              Al enviar se abrirá WhatsApp con este mensaje y tú decides si lo mandas. Usamos tus datos solo para preparar
              tu proforma. Más información en la <a href={asset('privacidad')}>Política de privacidad</a>.
            </p>
          </div>
        )}

        <p class="paso__error" role="alert" data-error></p>
      </fieldset>
    ))}

    <div class="asistente__nav">
      <button type="button" class="btn btn--borde" data-atras disabled>Atrás</button>
      <span class="asistente__atajo mono" aria-hidden="true">Enter ↵ para continuar</span>
      <button type="button" class="btn btn--indigo" data-siguiente>
        Continuar <Icon name="arrow" size={18} />
      </button>
      <button type="button" class="btn btn--wa" data-enviar hidden>
        <Icon name="whatsapp" size={20} /> Enviar por WhatsApp
      </button>
    </div>
  </form>

  <aside class="panel siempre-oscuro" aria-label="Resumen en vivo">
    <div class="panel__barra">
      <span class="mono">proforma.json</span>
      <button type="button" class="panel__copiar mono" data-copiar>copiar mensaje</button>
    </div>
    <pre class="panel__codigo" data-json aria-live="off"></pre>
    <div class="panel__estado mono">
      <span><i></i>sincronizado</span>
      <span data-completo>0% completo</span>
    </div>
  </aside>
</div>

<style>
  .cotizador {
    display: grid;
    gap: 24px;
    align-items: start;
  }

  .asistente {
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    background: var(--bg-2);
    box-shadow: var(--sombra);
  }

  .asistente__barra {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--borde);
    background: var(--bg);
    font-size: 12px;
    color: var(--texto-3);
  }

  .asistente__luces {
    display: inline-flex;
    gap: 6px;
  }

  .asistente__luces i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--borde-fuerte);
  }

  .asistente__luces i:first-child {
    background: var(--indigo);
  }

  .asistente__luces i:nth-child(2) {
    background: var(--lima);
  }

  .asistente__contador {
    margin-left: auto;
    color: var(--titulo);
  }

  .progreso-pasos {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 14px 18px 0;
    list-style: none;
  }

  .progreso-pasos li {
    position: relative;
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--bg-3);
    overflow: hidden;
  }

  .progreso-pasos li::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--lima);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }

  .progreso-pasos li.hecho::after {
    transform: none;
  }

  .progreso-pasos li.actual::after {
    background: var(--indigo);
    transform: none;
  }

  .progreso-pasos span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .paso {
    min-width: 0;
    margin: 0;
    padding: 28px clamp(18px, 4vw, 36px) 8px;
    border: 0;
  }

  .paso:not([hidden]) {
    animation: entrar-paso 0.45s var(--ease);
  }

  .paso.atras:not([hidden]) {
    animation-name: entrar-paso-atras;
  }

  .paso__prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--texto-3);
  }

  .paso__signo {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--lima);
    color: var(--tinta);
    font-weight: 500;
  }

  .paso__req {
    padding: 1px 7px;
    border: 1px solid var(--borde);
    border-radius: 5px;
    font-size: 11px;
  }

  .paso__titulo {
    margin-top: 14px;
    font-size: clamp(24px, 3.2vw, 32px);
    letter-spacing: -0.03em;
    outline: none;
  }

  .paso__ayuda {
    margin-top: 8px;
    color: var(--texto-2);
    font-size: 15.5px;
  }

  .sugerencia {
    margin-top: 18px;
    padding: 12px 14px;
    border: 1px solid var(--borde);
    border-left: 3px solid var(--lima);
    border-radius: 10px;
    background: var(--bg);
    font-size: 14.5px;
  }

  .sugerencia :global(strong) {
    color: var(--titulo);
  }

  .opciones {
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }

  .op {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .op input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .op__caja {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid var(--borde);
    border-radius: 12px;
    background: var(--bg);
    transition:
      border-color 0.2s,
      background-color 0.2s,
      translate 0.25s var(--ease);
  }

  .op:hover .op__caja {
    border-color: var(--borde-fuerte);
    translate: 0 -1px;
  }

  .op input:focus-visible + .op__caja {
    outline: 2px solid var(--acento);
    outline-offset: 2px;
  }

  .op input:checked + .op__caja {
    border-color: var(--acento);
    background: color-mix(in srgb, var(--acento) 8%, var(--bg));
  }

  .op__icono {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--bg-3);
    color: var(--acento-2);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .op input:checked + .op__caja .op__icono {
    background: var(--lima);
    color: var(--tinta);
  }

  .op__texto {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
  }

  .op__titulo {
    font-weight: 500;
    font-size: 15.5px;
    color: var(--titulo);
    line-height: 1.35;
  }

  .op__detalle {
    font-size: 13.5px;
    color: var(--texto-2);
  }

  .op__marca {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--borde-fuerte);
    border-radius: 6px;
    color: transparent;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .op input[type='radio'] + .op__caja .op__marca {
    border-radius: 50%;
  }

  .op input:checked + .op__caja .op__marca {
    border-color: var(--lima);
    background: var(--lima);
    color: var(--tinta);
  }

  .op__sugerido {
    position: absolute;
    top: -9px;
    right: 12px;
    display: none;
    padding: 1px 8px;
    border-radius: 5px;
    background: var(--indigo);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blanco);
  }

  .op[data-sugerido] .op__sugerido {
    display: block;
  }

  .op[data-sugerido]:not(:has(input:checked)) .op__caja {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--indigo) 55%, var(--borde));
  }

  .op--compacta .op__caja {
    padding: 11px 14px;
  }

  .funciones__acciones {
    margin-top: 18px;
  }

  .grupo-f {
    margin-top: 24px;
  }

  .grupo-f__titulo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-2);
  }

  .grupo-f .opciones {
    margin-top: 12px;
  }

  .campos {
    display: grid;
    gap: 16px;
    margin-top: 22px;
  }

  .campo {
    display: grid;
    gap: 8px;
  }

  .campo label {
    font-size: 15px;
    font-weight: 500;
    color: var(--titulo);
  }

  .obligatorio {
    color: var(--acento);
  }

  .campo input,
  .campo textarea {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--borde);
    border-radius: 12px;
    background: var(--bg);
    font-size: 16px;
    color: var(--texto);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .campo textarea {
    resize: vertical;
    min-height: 110px;
  }

  .campo ::placeholder {
    color: var(--texto-3);
  }

  .campo input:focus,
  .campo textarea:focus {
    outline: none;
    border-color: var(--indigo);
    box-shadow: 0 0 0 3px rgb(91 75 255 / 0.25);
  }

  .campo [aria-invalid='true'] {
    border-color: #ef4444;
  }

  .revision {
    display: grid;
    gap: 20px;
    margin-top: 22px;
  }

  .resumen {
    display: grid;
    margin: 0;
    border: 1px solid var(--borde);
    border-radius: 12px;
    overflow: hidden;
  }

  .resumen :global(div) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--borde);
    background: var(--bg);
  }

  .resumen :global(div:last-child) {
    border-bottom: 0;
  }

  .resumen :global(dt) {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-3);
  }

  .resumen :global(dd) {
    grid-column: 1;
    margin: 0;
    font-size: 15px;
    color: var(--titulo);
  }

  .resumen :global(button) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    padding: 6px 10px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: transparent;
    font-size: 13px;
    color: var(--texto-2);
  }

  .resumen :global(button:hover) {
    border-color: var(--acento);
    color: var(--acento);
  }

  .vista__titulo {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    font-size: 12px;
    color: var(--texto-3);
  }

  .vista__burbuja {
    margin: 0;
    padding: 14px 16px;
    border-radius: 4px 14px 14px 14px;
    background: color-mix(in srgb, var(--whatsapp) 14%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--whatsapp) 30%, var(--borde));
    font-family: var(--fuente);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--texto);
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 360px;
    overflow-y: auto;
  }

  .vista__burbuja :global(b) {
    color: var(--titulo);
  }

  .revision__nota {
    font-size: 13.5px;
    color: var(--texto-2);
  }

  .revision__nota a {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .paso__error {
    min-height: 1.5em;
    margin-top: 12px;
    font-size: 14px;
    color: #ef4444;
  }

  .asistente__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 16px clamp(18px, 4vw, 36px) 24px;
    border-top: 1px solid var(--borde);
  }

  .asistente__nav [data-siguiente],
  .asistente__nav [data-enviar] {
    margin-left: auto;
  }

  .asistente__nav [hidden] {
    display: none;
  }

  .asistente__nav button:disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .asistente__atajo {
    display: none;
    font-size: 12px;
    color: var(--texto-3);
  }

  .panel {
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    background: var(--bg-2);
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--texto);
  }

  .panel__barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--borde);
    background: var(--bg);
    font-size: 12px;
  }

  .panel__copiar {
    padding: 4px 9px;
    border: 1px solid var(--borde);
    border-radius: 6px;
    background: transparent;
    font-size: 11.5px;
    color: var(--texto-2);
  }

  .panel__copiar:hover {
    border-color: var(--lima);
    color: var(--lima);
  }

  .panel__codigo {
    margin: 0;
    padding: 16px 18px;
    max-height: 520px;
    overflow: auto;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .panel__codigo :global(.k) {
    color: #9a90ff;
  }

  .panel__codigo :global(.s) {
    color: var(--lima);
  }

  .panel__codigo :global(.n) {
    color: #7c859f;
  }

  .panel__codigo :global(.nuevo) {
    border-radius: 3px;
    animation: resaltar 1.2s var(--ease);
  }

  .panel__estado {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    border-top: 1px solid var(--borde);
    font-size: 11px;
    color: var(--texto-2);
  }

  .panel__estado i {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 2px;
    background: var(--whatsapp);
  }

  @keyframes entrar-paso {
    from {
      opacity: 0;
      transform: translateX(18px);
    }
  }

  @keyframes entrar-paso-atras {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }
  }

  @keyframes resaltar {
    from {
      background: rgb(198 244 50 / 0.25);
    }
  }

  @media (min-width: 640px) {
    .opciones {
      grid-template-columns: repeat(2, 1fr);
    }

    .campos {
      grid-template-columns: 1fr 1fr;
    }

    .campo--ancho {
      grid-column: 1 / -1;
    }

    .asistente__atajo {
      display: inline;
      margin-left: auto;
    }

    .asistente__nav [data-siguiente],
    .asistente__nav [data-enviar] {
      margin-left: 0;
    }

    .asistente__nav [data-enviar] {
      margin-left: auto;
    }
  }

  @media (min-width: 1100px) {
    .cotizador {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 32px;
    }

    .panel {
      position: sticky;
      top: calc(var(--header) + 24px);
    }
  }
</style>

<script>
  import { abrirWhatsApp } from '../scripts/whatsapp';
  import {
    PASOS,
    NEGOCIOS,
    OBJETIVOS,
    SOLUCIONES,
    USUARIOS,
    EXISTENTE,
    PLAZOS,
    PRESUPUESTOS_COTIZADOR,
  } from '../data/cotizador';

  const form = document.getElementById('asistente') as HTMLFormElement;
  const pasos = [...form.querySelectorAll<HTMLFieldSetElement>('.paso')];
  const segmentos = [...form.querySelectorAll<HTMLLIElement>('[data-segmento]')];
  const btnAtras = form.querySelector<HTMLButtonElement>('[data-atras]')!;
  const btnSiguiente = form.querySelector<HTMLButtonElement>('[data-siguiente]')!;
  const btnEnviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
  const contador = form.querySelector<HTMLElement>('[data-num]')!;
  const panelJson = document.querySelector<HTMLElement>('[data-json]')!;
  const panelCompleto = document.querySelector<HTMLElement>('[data-completo]')!;
  const btnCopiar = document.querySelector<HTMLButtonElement>('[data-copiar]')!;

  const FUNCIONES = SOLUCIONES.flatMap((s) => s.funciones.map((f) => ({ ...f, solucion: s.id })));
  const texto = (lista: { id: string; texto: string }[], id: string) => lista.find((o) => o.id === id)?.texto ?? id;
  const textos = (lista: { id: string; texto: string }[], ids: string[]) => ids.map((id) => texto(lista, id));

  let actual = 0;
  let anterior: Record<string, string> = {};

  function leer() {
    const d = new FormData(form);
    const uno = (k: string) => String(d.get(k) ?? '').trim();
    const varios = (k: string) => d.getAll(k).map(String);
    return {
      negocio: uno('negocio'),
      objetivos: varios('objetivos'),
      soluciones: varios('soluciones'),
      funciones: varios('funciones'),
      usuarios: uno('usuarios'),
      existente: varios('existente'),
      plazo: uno('plazo'),
      presupuesto: uno('presupuesto'),
      nombre: uno('nombre'),
      empresa: uno('empresa'),
      ciudad: uno('ciudad'),
      detalles: uno('detalles'),
    };
  }

  type Datos = ReturnType<typeof leer>;

  function recomendadas(d: Datos) {
    const puntos = new Map<string, number>();
    OBJETIVOS.filter((o) => d.objetivos.includes(o.id)).forEach((o) =>
      o.soluciones.forEach((s, i) => puntos.set(s, (puntos.get(s) ?? 0) + (i === 0 ? 2 : 1))),
    );
    const max = Math.max(0, ...puntos.values());
    return [...puntos].filter(([, p]) => p >= Math.max(2, max - 1)).map(([s]) => s);
  }

  function funcionesSugeridas(d: Datos) {
    return new Set(OBJETIVOS.filter((o) => d.objetivos.includes(o.id)).flatMap((o) => o.funciones));
  }

  function marcarSugeridos(paso: HTMLFieldSetElement, ids: Iterable<string>) {
    const set = new Set(ids);
    paso.querySelectorAll<HTMLLabelElement>('.op').forEach((op) => {
      op.toggleAttribute('data-sugerido', set.has(op.dataset.op!));
    });
  }

  function prepararPaso(i: number) {
    const paso = pasos[i];
    const d = leer();
    const id = paso.dataset.id;

    if (id === 'objetivos') {
      marcarSugeridos(paso, NEGOCIOS.find((n) => n.id === d.negocio)?.sugiere ?? []);
    }

    if (id === 'soluciones') {
      const rec = recomendadas(d);
      marcarSugeridos(paso, rec);
      const aviso = paso.querySelector<HTMLElement>('[data-recomendacion]')!;
      aviso.hidden = rec.length === 0;
      aviso.innerHTML = rec.length
        ? `Según lo que nos contaste, te recomendamos: <strong>${textos(SOLUCIONES, rec).join(' + ')}</strong>.`
        : '';
    }

    if (id === 'funciones') {
      const sugeridas = funcionesSugeridas(d);
      paso.querySelectorAll<HTMLElement>('[data-solucion]').forEach((g) => {
        const visible = d.soluciones.includes(g.dataset.solucion!);
        g.hidden = !visible;
        if (!visible) g.querySelectorAll('input').forEach((x) => (x.checked = false));
      });
      marcarSugeridos(paso, sugeridas);
    }

    if (id === 'revision') pintarRevision(d);
  }

  function validar(i: number) {
    const paso = pasos[i];
    const def = PASOS[i];
    const error = paso.querySelector<HTMLElement>('[data-error]')!;
    const d = leer();
    let mensaje = '';

    if (def.requerido) {
      const valor = d[def.id as keyof Datos];
      if (Array.isArray(valor) ? valor.length === 0 : !valor) {
        mensaje = def.tipo === 'unica' ? 'Elige una opción para continuar.' : 'Elige al menos una opción para continuar.';
      }
    }

    if (def.tipo === 'contacto') {
      const nombre = form.elements.namedItem('nombre') as HTMLInputElement;
      const ok = d.nombre.length >= 2;
      nombre.setAttribute('aria-invalid', String(!ok));
      if (!ok) {
        mensaje = 'Escribe tu nombre para poder dirigirnos a ti.';
        nombre.focus();
      }
    }

    error.textContent = mensaje;
    return !mensaje;
  }

  function ir(i: number, opciones: { validar?: boolean } = {}) {
    if (i === actual) return;
    if (opciones.validar !== false && i > actual) {
      for (let p = actual; p < i; p++) {
        if (!validar(p)) {
          if (p !== actual) ir(p, { validar: false });
          return;
        }
      }
    }

    const haciaAtras = i < actual;
    pasos[actual].hidden = true;
    actual = i;
    prepararPaso(i);

    const paso = pasos[i];
    paso.classList.toggle('atras', haciaAtras);
    paso.hidden = false;
    paso.querySelector<HTMLElement>('[data-error]')!.textContent = '';

    const ultimo = i === pasos.length - 1;
    btnAtras.disabled = i === 0;
    btnSiguiente.hidden = ultimo;
    btnEnviar.hidden = !ultimo;
    contador.textContent = String(i + 1);
    segmentos.forEach((s, n) => {
      s.classList.toggle('hecho', n < i);
      s.classList.toggle('actual', n === i);
    });

    paso.querySelector<HTMLElement>('.paso__titulo')!.focus({ preventScroll: true });
    const margen = document.getElementById('header')!.offsetHeight + 16;
    const arriba = form.getBoundingClientRect().top;
    if (arriba < margen || arriba > innerHeight * 0.4) {
      scrollTo({ top: scrollY + arriba - margen, behavior: 'smooth' });
    }
  }

  function construirMensaje(d: Datos) {
    const lineas: string[] = ['Hola AlphaBytes 👋 Armé mi proyecto en su cotizador:', ''];
    const agregar = (etiqueta: string, valor: string) => valor && lineas.push(`*${etiqueta}:* ${valor}`);

    agregar('Cliente', [d.nombre, d.empresa, d.ciudad].filter(Boolean).join(' · '));
    agregar('Tipo de negocio', d.negocio ? texto(NEGOCIOS, d.negocio) : '');
    agregar('Objetivos', textos(OBJETIVOS, d.objetivos).join(', '));
    agregar('Solución', textos(SOLUCIONES, d.soluciones).join(' + '));

    const porSolucion = d.soluciones
      .map((s) => {
        const fs = FUNCIONES.filter((f) => f.solucion === s && d.funciones.includes(f.id)).map((f) => f.texto);
        return fs.length ? `• ${texto(SOLUCIONES, s)}: ${fs.join(', ')}` : '';
      })
      .filter(Boolean);
    if (porSolucion.length) lineas.push('*Funciones:*', ...porSolucion);

    agregar('Usuarios', d.usuarios ? texto(USUARIOS, d.usuarios) : '');
    agregar('Ya cuento con', textos(EXISTENTE, d.existente).join(', '));
    agregar('Plazo', d.plazo ? texto(PLAZOS, d.plazo) : '');
    agregar('Presupuesto', d.presupuesto ? texto(PRESUPUESTOS_COTIZADOR, d.presupuesto) : 'Por definir');
    agregar('Detalles', d.detalles);

    lineas.push('', '¿Me pueden preparar una proforma?');
    return lineas.join('\n');
  }

  const escapar = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function pintarRevision(d: Datos) {
    const resumen = form.querySelector<HTMLElement>('[data-resumen]')!;
    const filas: [string, string, number][] = [
      ['Negocio', d.negocio ? texto(NEGOCIOS, d.negocio) : '—', 0],
      ['Objetivos', textos(OBJETIVOS, d.objetivos).join(', ') || '—', 1],
      ['Solución', textos(SOLUCIONES, d.soluciones).join(' + ') || '—', 2],
      ['Funciones', textos(FUNCIONES, d.funciones).join(', ') || 'Por definir juntos', 3],
      ['Usuarios', d.usuarios ? texto(USUARIOS, d.usuarios) : '—', 4],
      ['Ya cuenta con', textos(EXISTENTE, d.existente).join(', ') || '—', 5],
      ['Plazo', d.plazo ? texto(PLAZOS, d.plazo) : '—', 6],
      ['Presupuesto', d.presupuesto ? texto(PRESUPUESTOS_COTIZADOR, d.presupuesto) : 'Por definir', 7],
      ['Contacto', [d.nombre, d.empresa, d.ciudad].filter(Boolean).join(' · '), 8],
    ];
    resumen.innerHTML = filas
      .map(
        ([dt, dd, paso]) =>
          `<div><dt>${dt}</dt><dd>${escapar(dd)}</dd><button type="button" data-editar="${paso}" aria-label="Editar ${dt}">Editar</button></div>`,
      )
      .join('');

    const vista = form.querySelector<HTMLElement>('[data-vista]')!;
    vista.innerHTML = escapar(construirMensaje(d)).replace(/\*([^*\n]+)\*/g, '<b>$1</b>');
  }

  function pintarPanel() {
    const d = leer();
    const obj: Record<string, string | string[]> = {
      negocio: d.negocio ? texto(NEGOCIOS, d.negocio) : '',
      objetivos: textos(OBJETIVOS, d.objetivos),
      solucion: textos(SOLUCIONES, d.soluciones),
      funciones: textos(FUNCIONES, d.funciones),
      usuarios: d.usuarios ? texto(USUARIOS, d.usuarios) : '',
      existente: textos(EXISTENTE, d.existente),
      plazo: d.plazo ? texto(PLAZOS, d.plazo) : '',
      presupuesto: d.presupuesto ? texto(PRESUPUESTOS_COTIZADOR, d.presupuesto) : '',
      cliente: [d.nombre, d.empresa, d.ciudad].filter(Boolean).join(' · '),
    };

    const valor = (v: string | string[]) => {
      if (Array.isArray(v)) {
        if (!v.length) return '<span class="n">[]</span>';
        return `[\n${v.map((x) => `    <span class="s">"${escapar(x)}"</span>`).join(',\n')}\n  ]`;
      }
      return v ? `<span class="s">"${escapar(v)}"</span>` : '<span class="n">null</span>';
    };

    const actualJson: Record<string, string> = {};
    const lineas = Object.entries(obj).map(([k, v]) => {
      actualJson[k] = JSON.stringify(v);
      const cambio = anterior[k] !== undefined && anterior[k] !== actualJson[k];
      const linea = `  <span class="k">"${k}"</span>: ${valor(v)}`;
      return cambio ? `<span class="nuevo">${linea}</span>` : linea;
    });
    anterior = actualJson;
    panelJson.innerHTML = `{\n${lineas.join(',\n')}\n}`;

    const llenos = Object.values(obj).filter((v) => (Array.isArray(v) ? v.length : v)).length;
    panelCompleto.textContent = `${Math.round((llenos / Object.keys(obj).length) * 100)}% completo`;
  }

  form.addEventListener('change', (e) => {
    pintarPanel();
    const input = e.target as HTMLInputElement;
    const def = PASOS[actual];
    if (input.type === 'radio' && def.tipo === 'unica' && actual < pasos.length - 1) {
      setTimeout(() => ir(actual + 1), 260);
    }
    if (input.checked) pasos[actual].querySelector<HTMLElement>('[data-error]')!.textContent = '';
  });

  form.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).matches('input[type="text"], textarea')) pintarPanel();
  });

  form.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const editar = t.closest<HTMLButtonElement>('[data-editar]');
    if (editar) ir(Number(editar.dataset.editar), { validar: false });

    if (t.closest('[data-marcar-sugeridas]')) {
      pasos[actual].querySelectorAll<HTMLLabelElement>('.op[data-sugerido]').forEach((op) => {
        const input = op.querySelector('input')!;
        if (!op.closest('[hidden]')) input.checked = true;
      });
      pintarPanel();
    }
  });

  form.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || (e.target as HTMLElement).tagName === 'TEXTAREA') return;
    if ((e.target as HTMLElement).closest('button')) return;
    e.preventDefault();
    if (actual < pasos.length - 1) ir(actual + 1);
  });

  form.addEventListener('submit', (e) => e.preventDefault());
  btnSiguiente.addEventListener('click', () => ir(actual + 1));
  btnAtras.addEventListener('click', () => ir(actual - 1, { validar: false }));

  btnEnviar.addEventListener('click', () => {
    for (let p = 0; p < pasos.length - 1; p++) {
      if (!validar(p)) return ir(p, { validar: false });
    }
    abrirWhatsApp(construirMensaje(leer()));
  });

  btnCopiar.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(construirMensaje(leer()));
      btnCopiar.textContent = 'copiado ✓';
    } catch {
      btnCopiar.textContent = 'no se pudo copiar';
    }
    setTimeout(() => (btnCopiar.textContent = 'copiar mensaje'), 1800);
  });

  segmentos[0].classList.add('actual');
  pintarPanel();
</script>
