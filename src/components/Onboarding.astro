<script>
  import { abrirWhatsApp } from '../scripts/whatsapp';
  import {
    PASOS,
    NEGOCIOS,
    OBJETIVOS,
    SOLUCIONES,
    USUARIOS,
    EXISTENTE,
    PLAZOS,
    PRESUPUESTOS_COTIZADOR,
  } from '../data/cotizador';

  type Lista = { id: string; texto: string }[];

  const raiz = document.querySelector<HTMLElement>('.ob')!;
  const form = document.getElementById('onboarding') as HTMLFormElement;
  const pasos = [...form.querySelectorAll<HTMLFieldSetElement>('.paso')];
  const pantallaInicio = raiz.querySelector<HTMLElement>('[data-pantalla="inicio"]')!;
  const pantallaAnalisis = raiz.querySelector<HTMLElement>('[data-pantalla="analizando"]')!;
  const pantallaListo = raiz.querySelector<HTMLElement>('[data-pantalla="listo"]')!;
  const pie = raiz.querySelector<HTMLElement>('[data-pie]')!;
  const btnAtras = raiz.querySelector<HTMLButtonElement>('[data-atras]')!;
  const btnSiguiente = raiz.querySelector<HTMLButtonElement>('[data-siguiente]')!;
  const btnOmitir = raiz.querySelector<HTMLButtonElement>('[data-omitir]')!;
  const barra = raiz.querySelector<HTMLElement>('[data-barra]')!;
  const progreso = raiz.querySelector<HTMLElement>('.escena__progreso')!;
  const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;
  const lienzoPaso = raiz.querySelector<HTMLElement>('[data-lienzo-paso]')!;
  const lienzoTitulo = raiz.querySelector<HTMLElement>('[data-lienzo-titulo]')!;
  const construccion = raiz.querySelector<HTMLElement>('[data-construccion]')!;
  const nodos = [...raiz.querySelectorAll<HTMLElement>('[data-nodo]')];
  const rangoInput = form.querySelector<HTMLInputElement>('input[type="range"]')!;
  const rangoValor = form.querySelector<HTMLOutputElement>('[data-rango-valor]')!;
  const asesoria = form.querySelector<HTMLInputElement>('input[name="asesoria"]')!;

  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const FUNCIONES = SOLUCIONES.flatMap((s) => s.funciones.map((f) => ({ ...f, solucion: s.id })));
  const texto = (lista: Lista, id: string) => lista.find((o) => o.id === id)?.texto ?? id;
  const textos = (lista: Lista, ids: string[]) => ids.map((id) => texto(lista, id));
  const escapar = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  let actual = -1;
  let presupuestoElegido = '';
  const visitados = new Set<string>();
  let lineasPrevias = new Set<string>();

  function leer() {
    const d = new FormData(form);
    const uno = (k: string) => String(d.get(k) ?? '').trim();
    const varios = (k: string) => d.getAll(k).map(String);
    return {
      nombre: uno('nombre'),
      negocio: uno('negocio'),
      objetivos: varios('objetivos'),
      soluciones: varios('soluciones'),
      funciones: varios('funciones'),
      usuarios: uno('usuarios'),
      existente: varios('existente'),
      plazo: uno('plazo'),
      presupuesto: asesoria.checked ? 'Necesito asesoría' : presupuestoElegido,
      empresa: uno('empresa'),
      ciudad: uno('ciudad'),
      detalles: uno('detalles'),
    };
  }

  type Datos = ReturnType<typeof leer>;
  const primerNombre = (d: Datos) => d.nombre.split(/\s+/)[0] ?? '';

  function recomendadas(d: Datos) {
    const puntos = new Map<string, { p: number; motivos: string[] }>();
    OBJETIVOS.filter((o) => d.objetivos.includes(o.id)).forEach((o) =>
      o.soluciones.forEach((s, i) => {
        const r = puntos.get(s) ?? { p: 0, motivos: [] };
        r.p += i === 0 ? 2 : 1;
        r.motivos.push(o.texto.toLowerCase());
        puntos.set(s, r);
      }),
    );
    const max = Math.max(0, ...[...puntos.values()].map((r) => r.p));
    return new Map([...puntos].filter(([, r]) => r.p >= Math.max(2, max - 1)));
  }

  function mensajeAsistente(id: string, d: Datos) {
    const nombre = primerNombre(d);
    const negocio = NEGOCIOS.find((n) => n.id === d.negocio);
    switch (id) {
      case 'nombre':
        return 'Te haré unas preguntas rápidas para entender tu proyecto. ¿Empezamos?';
      case 'negocio':
        return `¡Mucho gusto, ${nombre}! Cuéntame un poco sobre tu negocio.`;
      case 'objetivos':
        return negocio?.reaccion ?? 'Ahora cuéntame qué quieres lograr.';
      case 'soluciones': {
        const n = d.objetivos.length;
        return n > 2
          ? `${n} objetivos, ¡ambicioso! Analicé tus respuestas y armé una recomendación.`
          : 'Perfecto. Según lo que me contaste, esto es lo que mejor te funcionaría.';
      }
      case 'funciones':
        return `Buena elección: ${textos(SOLUCIONES, d.soluciones).join(' + ')}. Te marqué las funciones que suelen necesitarse.`;
      case 'usuarios':
        return `Vamos muy bien, ${nombre}. Ya tenemos la base del proyecto.`;
      case 'existente':
        return d.usuarios === 'publico'
          ? 'Si lo usarán tus clientes, cuidaremos que sea muy fácil de usar.'
          : d.usuarios === 'solo'
            ? 'Perfecto, lo haremos simple y práctico para ti.'
            : 'Entendido, definiremos qué puede hacer cada persona.';
      case 'plazo':
        if (d.existente.includes('excel')) return 'Pasar de Excel a un sistema es de los cambios que más se notan.';
        if (d.existente.includes('nada')) return 'Empezar desde cero nos permite hacerlo bien desde el inicio.';
        return 'Genial, aprovecharemos lo que ya tienes.';
      case 'presupuesto':
        return d.plazo === 'urgente'
          ? 'Entendido, priorizaremos lo esencial para llegar a tiempo.'
          : 'Perfecto, así podemos planificar con calma.';
      case 'extras':
        return `Último paso, ${nombre}. Si quieres, déjanos más detalles.`;
      default:
        return '';
    }
  }

  function escribirBurbuja(burbuja: HTMLElement, mensaje: string) {
    burbuja.innerHTML = '<span class="escribiendo" aria-hidden="true"><i></i><i></i><i></i></span>';
    setTimeout(
      () => {
        burbuja.innerHTML = `<span class="texto-burbuja">${escapar(mensaje)}</span>`;
      },
      reducido ? 0 : 650,
    );
  }

  function marcarSugeridos(paso: HTMLElement, ids: Iterable<string>) {
    const set = new Set(ids);
    paso.querySelectorAll<HTMLElement>('[data-op]').forEach((op) => op.toggleAttribute('data-sugerido', set.has(op.dataset.op!)));
  }

  function prepararPaso(i: number) {
    const paso = pasos[i];
    const def = PASOS[i];
    const d = leer();
    const primeraVez = !visitados.has(def.id);
    visitados.add(def.id);

    const titulo = paso.querySelector<HTMLElement>('[data-titulo]')!;
    const plantilla = titulo.dataset.titulo!;
    titulo.textContent = d.nombre ? plantilla.replace('{nombre}', primerNombre(d)) : plantilla.replace('{nombre}, ', '');
    if (titulo.textContent) titulo.textContent = titulo.textContent[0].toUpperCase() + titulo.textContent.slice(1);

    escribirBurbuja(paso.querySelector<HTMLElement>('[data-burbuja]')!, mensajeAsistente(def.id, d));

    if (def.id === 'objetivos') {
      marcarSugeridos(paso, NEGOCIOS.find((n) => n.id === d.negocio)?.sugiere ?? []);
    }

    if (def.id === 'soluciones') {
      const rec = recomendadas(d);
      marcarSugeridos(paso, rec.keys());
      paso.querySelectorAll<HTMLElement>('.tarjeta--solucion').forEach((t) => {
        const r = rec.get(t.dataset.op!);
        t.querySelector<HTMLElement>('[data-motivo]')!.textContent = r ? `→ para ${r.motivos.slice(0, 2).join(' y ')}` : '';
        if (primeraVez && r) t.querySelector('input')!.checked = true;
      });
      const contenedor = paso.querySelector<HTMLElement>('.tarjetas')!;
      [...contenedor.children]
        .sort((a, b) => Number(b.hasAttribute('data-sugerido')) - Number(a.hasAttribute('data-sugerido')))
        .forEach((el, n) => {
          (el as HTMLElement).style.setProperty('--i', String(n));
          contenedor.append(el);
        });
    }

    if (def.id === 'funciones') {
      const sugeridas = new Set(OBJETIVOS.filter((o) => d.objetivos.includes(o.id)).flatMap((o) => o.funciones));
      paso.querySelectorAll<HTMLElement>('[data-solucion]').forEach((g) => {
        const visible = d.soluciones.includes(g.dataset.solucion!);
        g.hidden = !visible;
        g.querySelectorAll<HTMLInputElement>('input').forEach((x) => {
          if (!visible) x.checked = false;
          else if (primeraVez && sugeridas.has(x.value)) x.checked = true;
        });
      });
      marcarSugeridos(paso, sugeridas);
    }

    if (def.id === 'presupuesto') actualizarRango();
  }

  function validar(i: number) {
    const def = PASOS[i];
    const error = pasos[i].querySelector<HTMLElement>('[data-error]')!;
    const d = leer();
    let mensaje = '';
    if (def.id === 'nombre' && d.nombre.length < 2) mensaje = 'Escribe tu nombre para continuar.';
    else if (def.requerido && def.id !== 'nombre') {
      const valor = d[def.id as keyof Datos];
      if (Array.isArray(valor) ? !valor.length : !valor) {
        mensaje = def.tipo === 'unica' ? 'Elige una opción para continuar.' : 'Elige al menos una opción para continuar.';
      }
    }
    error.textContent = mensaje;
    return !mensaje;
  }

  function actualizarUI() {
    const enPasos = actual >= 0 && actual < pasos.length;
    pie.hidden = !enPasos;
    btnAtras.disabled = false;
    btnOmitir.hidden = !enPasos || !PASOS[actual]?.omitible;
    const pct = actual < 0 ? 0 : Math.min(1, (actual + 1) / pasos.length);
    barra.parentElement!.style.setProperty('--p', String(pct));
    progreso.setAttribute('aria-valuenow', String(Math.max(0, actual + 1)));
    contador.hidden = !enPasos;
    contador.textContent = `${String(actual + 1).padStart(2, '0')} / ${pasos.length}`;
    btnSiguiente.innerHTML =
      actual === pasos.length - 1
        ? 'Ver mi proyecto <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>'
        : 'Continuar <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';

    if (enPasos) {
      lienzoPaso.textContent = `paso ${String(actual + 1).padStart(2, '0')} · ${PASOS[actual].id}`;
      lienzoTitulo.textContent = PASOS[actual].panel;
    }
    pintarLienzo();
  }

  function mostrar(el: HTMLElement, atras = false) {
    [pantallaInicio, form, pantallaAnalisis, pantallaListo, ...pasos].forEach((p) => {
      if (p !== el && p !== form) p.hidden = true;
    });
    el.classList.toggle('atras', atras);
    el.hidden = false;
  }

  function ir(i: number, atras = false) {
    if (i < 0) {
      actual = -1;
      form.hidden = true;
      mostrar(pantallaInicio, true);
      raiz.dataset.fase = 'inicio';
      actualizarUI();
      return;
    }
    if (i >= pasos.length) return analizar();

    actual = i;
    form.hidden = false;
    raiz.dataset.fase = 'pasos';
    prepararPaso(i);
    mostrar(pasos[i], atras);
    pasos[i].querySelector<HTMLElement>('[data-error]')!.textContent = '';
    actualizarUI();
    scrollTo({ top: 0, behavior: reducido ? 'auto' : 'smooth' });

    const foco = pasos[i].querySelector<HTMLInputElement>('input[type="text"]') ?? pasos[i].querySelector<HTMLElement>('[data-titulo]');
    setTimeout(() => foco?.focus({ preventScroll: true }), reducido ? 0 : 350);
  }

  function siguiente() {
    if (actual < 0) return ir(0);
    if (!validar(actual)) return;
    if (PASOS[actual].id === 'presupuesto' && !asesoria.checked) {
      presupuestoElegido = PRESUPUESTOS_COTIZADOR[Number(rangoInput.value)].texto;
    }
    ir(actual + 1);
  }

  function omitir() {
    const def = PASOS[actual];
    if (def.id === 'presupuesto') {
      presupuestoElegido = '';
      asesoria.checked = false;
    }
    ir(actual + 1);
  }

  function actualizarRango() {
    const i = Number(rangoInput.value);
    const t = PRESUPUESTOS_COTIZADOR[i].texto;
    rangoValor.textContent = asesoria.checked ? 'Que me asesoren' : t;
    rangoInput.setAttribute('aria-valuetext', t);
    rangoInput.style.setProperty('--lleno', `${(i / (PRESUPUESTOS_COTIZADOR.length - 1)) * 100}%`);
    rangoInput.closest('.rango')!.classList.toggle('asesoria', asesoria.checked);
  }

  function pintarLienzo() {
    const d = leer();
    const rec = actual >= 3 || raiz.dataset.fase === 'listo' ? new Map() : recomendadas(d);
    nodos.forEach((n) => {
      n.classList.toggle('activo', d.soluciones.includes(n.dataset.nodo!));
      n.classList.toggle('recomendado', rec.has(n.dataset.nodo!));
    });

    const filas: [string, string][] = [
      ['cliente', d.nombre],
      ['negocio', d.negocio ? texto(NEGOCIOS, d.negocio) : ''],
      ['objetivos', d.objetivos.length ? `${d.objetivos.length} elegidos` : ''],
      ['solucion', textos(SOLUCIONES, d.soluciones).join(' + ')],
      ['funciones', d.funciones.length ? `${d.funciones.length} funciones` : ''],
      ['usuarios', d.usuarios ? (USUARIOS.find((u) => u.id === d.usuarios)?.valor ?? '') : ''],
      ['plazo', d.plazo ? (PLAZOS.find((p) => p.id === d.plazo)?.valor ?? '') : ''],
      ['inversion', d.presupuesto],
    ];
    const llenas = filas.filter(([, v]) => v);
    const nuevas = new Set(llenas.map(([k, v]) => `${k}:${v}`));
    const cuerpo = llenas
      .map(([k, v]) => {
        const linea = `  <span class="k">${k}</span>: <span class="s">"${escapar(v)}"</span>`;
        return lineasPrevias.has(`${k}:${v}`) ? linea : `<span class="nueva">${linea}</span>`;
      })
      .join(',\n');
    lineasPrevias = nuevas;
    construccion.innerHTML = `<span class="k">const</span> proyecto = {\n${cuerpo || '  <span style="opacity:.5">// se completa con tus respuestas</span>'}\n}`;
  }

  function usuariosTexto(d: Datos) {
    const u = USUARIOS.find((x) => x.id === d.usuarios);
    if (!u) return '';
    return u.id === 'publico' || u.id === 'solo' ? u.texto : `${u.texto} (${u.valor} personas)`;
  }

  function alcance(d: Datos) {
    const puntos = d.soluciones.length * 2 + d.funciones.length + (['grande', 'publico'].includes(d.usuarios) ? 2 : 0);
    if (puntos <= 6) return { nivel: 1, texto: 'Básico' };
    if (puntos <= 12) return { nivel: 2, texto: 'Intermedio' };
    return { nivel: 3, texto: 'Avanzado' };
  }

  function construirMensaje(d: Datos) {
    const l: string[] = ['Hola AlphaBytes 👋 Armé mi proyecto en su asistente:', ''];
    const add = (k: string, v: string) => v && l.push(`*${k}:* ${v}`);
    add('Cliente', [d.nombre, d.empresa, d.ciudad].filter(Boolean).join(' · '));
    add('Tipo de negocio', d.negocio ? texto(NEGOCIOS, d.negocio) : '');
    add('Objetivos', textos(OBJETIVOS, d.objetivos).join(', '));
    add('Solución', textos(SOLUCIONES, d.soluciones).join(' + '));
    const grupos = d.soluciones
      .map((s) => {
        const fs = FUNCIONES.filter((f) => f.solucion === s && d.funciones.includes(f.id)).map((f) => f.texto);
        return fs.length ? `• ${texto(SOLUCIONES, s)}: ${fs.join(', ')}` : '';
      })
      .filter(Boolean);
    if (grupos.length) l.push('*Funciones:*', ...grupos);
    add('Usuarios', usuariosTexto(d));
    add('Ya cuento con', textos(EXISTENTE, d.existente).join(', '));
    add('Plazo', d.plazo ? `${texto(PLAZOS, d.plazo)} (${PLAZOS.find((p) => p.id === d.plazo)?.valor})` : '');
    add('Presupuesto', d.presupuesto || 'Por definir');
    add('Alcance estimado', alcance(d).texto);
    add('Detalles', d.detalles);
    l.push('', '¿Me pueden preparar una proforma?');
    return l.join('\n');
  }

  function analizar() {
    const d = leer();
    actual = pasos.length;
    form.hidden = true;
    raiz.dataset.fase = 'analizando';
    mostrar(pantallaAnalisis);
    pie.hidden = true;
    barra.parentElement!.style.setProperty('--p', '1');
    lienzoPaso.textContent = 'analizando';
    lienzoTitulo.textContent = 'Armando tu proyecto…';

    const stack = [...new Set(SOLUCIONES.filter((s) => d.soluciones.includes(s.id)).flatMap((s) => s.stack))];
    const lineas = [
      ['leyendo respuestas', `${d.objetivos.length} objetivos`],
      ['definiendo solución', textos(SOLUCIONES, d.soluciones).join(' + ')],
      ['seleccionando tecnologías', stack.join(', ')],
      ['estimando alcance', alcance(d).texto],
      ['generando resumen para WhatsApp', 'listo'],
    ];
    const log = pantallaAnalisis.querySelector<HTMLElement>('[data-log]')!;
    log.innerHTML = '';
    const paso = reducido ? 80 : 520;
    lineas.forEach(([accion, resultado], n) =>
      setTimeout(() => {
        const li = document.createElement('li');
        li.innerHTML = `<b>✓</b> <span>${escapar(accion)}…</span> <em>${escapar(resultado)}</em>`;
        log.append(li);
      }, paso * (n + 1)),
    );
    setTimeout(() => resultado(), paso * (lineas.length + 1.6));
  }

  function resultado() {
    const d = leer();
    raiz.dataset.fase = 'listo';
    mostrar(pantallaListo);
    lienzoPaso.textContent = 'completado';
    lienzoTitulo.textContent = '¡Tu proyecto está listo!';
    pintarLienzo();

    const nombre = primerNombre(d);
    pantallaListo.querySelector<HTMLElement>('[data-titulo-final]')!.textContent = `${nombre}, tu proyecto está listo`;
    escribirBurbuja(
      pantallaListo.querySelector<HTMLElement>('[data-burbuja-final]')!,
      'Revisa el resumen y envíamelo por WhatsApp. Con esto preparo tu proforma a medida.',
    );

    const iconos: Record<string, string> = Object.fromEntries(
      [...document.querySelectorAll<HTMLElement>('[data-nodo]')].map((n) => [n.dataset.nodo!, n.querySelector('svg')!.outerHTML]),
    );
    pantallaListo.querySelector<HTMLElement>('[data-res-soluciones]')!.innerHTML = d.soluciones
      .map((s) => `<div><span>${iconos[s] ?? ''}</span><strong>${escapar(texto(SOLUCIONES, s))}</strong></div>`)
      .join('');

    const chips = (ids: string[], lista: Lista) =>
      ids.length ? ids.map((x) => `<span>${escapar(texto(lista, x))}</span>`).join('') : '<span>Por definir juntos</span>';
    pantallaListo.querySelector<HTMLElement>('[data-res-funciones]')!.innerHTML = chips(d.funciones, FUNCIONES);

    const stack = [...new Set(SOLUCIONES.filter((s) => d.soluciones.includes(s.id)).flatMap((s) => s.stack))];
    pantallaListo.querySelector<HTMLElement>('[data-res-stack]')!.innerHTML = stack.map((s) => `<span>${s}</span>`).join('');

    const datos: [string, string][] = [
      ['Negocio', d.negocio ? texto(NEGOCIOS, d.negocio) : '—'],
      ['Usuarios', usuariosTexto(d) || '—'],
      ['Plazo', d.plazo ? texto(PLAZOS, d.plazo) : 'Por definir'],
      ['Inversión', d.presupuesto || 'Por definir'],
    ];
    pantallaListo.querySelector<HTMLElement>('[data-res-datos]')!.innerHTML = datos
      .map(([k, v]) => `<div><dt>${k}</dt><dd>${escapar(v)}</dd></div>`)
      .join('');

    const a = alcance(d);
    pantallaListo.querySelector<HTMLElement>('[data-alcance]')!.innerHTML =
      `alcance <i>${[1, 2, 3].map((n) => `<b class="${n <= a.nivel ? 'on' : ''}"></b>`).join('')}</i> ${a.texto}`;

    pantallaListo.querySelector<HTMLElement>('[data-mensaje]')!.innerHTML = escapar(construirMensaje(d)).replace(
      /\*([^*\n]+)\*/g,
      '<b>$1</b>',
    );

    confeti();
    pantallaListo.querySelector<HTMLElement>('[data-titulo-final]')!.focus({ preventScroll: true });
    scrollTo({ top: 0, behavior: reducido ? 'auto' : 'smooth' });
  }

  function confeti() {
    if (reducido) return;
    const capa = pantallaListo.querySelector<HTMLElement>('[data-confeti]')!;
    const colores = ['#c6f432', '#5b4bff', '#9a90ff', '#25d366'];
    capa.innerHTML = Array.from({ length: 36 }, () => {
      const estilo = [
        `--x:${Math.random() * 100}%`,
        `--t:${6 + Math.random() * 8}px`,
        `--c:${colores[Math.floor(Math.random() * colores.length)]}`,
        `--d:${1.2 + Math.random() * 1.2}s`,
        `--dx:${(Math.random() - 0.5) * 160}px`,
        `--r:${(Math.random() - 0.5) * 540}deg`,
      ].join(';');
      return `<i style="${estilo}"></i>`;
    }).join('');
    setTimeout(() => (capa.innerHTML = ''), 2600);
  }

  raiz.querySelector('[data-empezar]')!.addEventListener('click', () => ir(0));
  btnSiguiente.addEventListener('click', siguiente);
  btnAtras.addEventListener('click', () => ir(actual - 1, true));
  btnOmitir.addEventListener('click', omitir);
  form.addEventListener('submit', (e) => e.preventDefault());

  form.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.checked) pasos[actual]?.querySelector<HTMLElement>('[data-error]')!.replaceChildren();
    if (input.name === 'asesoria') actualizarRango();
    pintarLienzo();
    if (input.type === 'radio' && PASOS[actual]?.tipo === 'unica') {
      setTimeout(() => {
        if (PASOS[actual]?.id === input.name) siguiente();
      }, reducido ? 0 : 380);
    }
  });

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.type === 'range') {
      asesoria.checked = false;
      actualizarRango();
    }
    if (t.name === 'nombre') pintarLienzo();
  });

  form.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-agregar]');
    if (!chip) return;
    const area = form.querySelector<HTMLTextAreaElement>('textarea[name="detalles"]')!;
    area.value = [area.value.trim(), chip.dataset.agregar].filter(Boolean).join('. ');
    chip.classList.add('usada');
    area.focus();
  });

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const esTexto = t.matches('textarea, input[type="text"], input[type="range"]');
    const escribiendo = t.matches('textarea, input[type="text"]:not([name="nombre"])');
    const fase = raiz.dataset.fase;

    if (e.key === 'Enter' && !e.shiftKey && !escribiendo && !t.closest('a, button, summary')) {
      if (fase === 'inicio') {
        e.preventDefault();
        ir(0);
      } else if (fase === 'pasos') {
        e.preventDefault();
        siguiente();
      }
      return;
    }

    if (fase === 'pasos' && /^[1-9]$/.test(e.key) && !esTexto) {
      const inputs = [...pasos[actual].querySelectorAll<HTMLInputElement>('.tarjeta input')].filter(
        (x) => !x.closest('[hidden]'),
      );
      const input = inputs[Number(e.key) - 1];
      if (!input) return;
      input.checked = input.type === 'radio' ? true : !input.checked;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });

  raiz.querySelector('[data-enviar]')!.addEventListener('click', () => abrirWhatsApp(construirMensaje(leer())));

  const btnCopiar = raiz.querySelector<HTMLButtonElement>('[data-copiar]')!;
  btnCopiar.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(construirMensaje(leer()));
      btnCopiar.textContent = '¡Copiado!';
    } catch {
      btnCopiar.textContent = 'No se pudo copiar';
    }
    setTimeout(() => (btnCopiar.textContent = 'Copiar mensaje'), 1800);
  });

  raiz.querySelector('[data-revisar]')!.addEventListener('click', () => ir(1, true));

  actualizarUI();
</script>
