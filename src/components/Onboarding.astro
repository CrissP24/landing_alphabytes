---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { asset } from '../lib/url';
import { PASOS, SOLUCIONES, PRESUPUESTOS_COTIZADOR } from '../data/cotizador';

const total = PASOS.length;
const orbita = SOLUCIONES.map((s) => ({ id: s.id, icono: s.icono! }));
const sugerenciasExtras = [
  'Tengo una página de referencia que me gusta',
  'Necesito migrar datos desde Excel',
  'Quiero capacitación para mi equipo',
  'Debe funcionar en celulares',
  'Necesito que sea en varios idiomas',
];
---

<div class="ob" data-fase="inicio">
  <aside class="lienzo siempre-oscuro" aria-hidden="true">
    <div class="lienzo__arriba">
      <img src={asset('logos/alphabytes-horizontal-negativo.svg')} alt="" width="140" height="32" />
    </div>

    <div class="orbita">
      <div class="orbita__anillo orbita__anillo--1"></div>
      <div class="orbita__anillo orbita__anillo--2"></div>
      <div class="orbita__centro">
        <svg viewBox="0 0 100 100" width="64" height="64">
          <rect width="100" height="100" rx="24" fill="#5B4BFF"></rect>
          <path d="M71 30 C64 54 57 71 42 71 C30 71 25 62 25 51 C25 39 32 31 43 31 C56 31 61 55 74 71" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" stroke="#FFFFFF"></path>
          <rect x="76" y="19" width="10" height="10" rx="2" fill="#C6F432"></rect>
        </svg>
      </div>
      {orbita.map((o, i) => (
        <span class="orbita__nodo" data-nodo={o.id} style={`--a: ${i * 60}deg`}>
          <span><Icon name={o.icono} size={22} /></span>
        </span>
      ))}
    </div>

    <div class="lienzo__texto">
      <p class="lienzo__paso mono" data-lienzo-paso>bienvenida</p>
      <p class="lienzo__titulo" data-lienzo-titulo>Tu proyecto empieza aquí</p>
    </div>

    <pre class="construccion mono" data-construccion></pre>
  </aside>

  <section class="escena" aria-labelledby="ob-titulo">
    <header class="escena__barra">
      <a class="escena__logo" href={asset('')} aria-label="AlphaBytes, ir al inicio">
        <img class="logo-oscuro" src={asset('logos/alphabytes-horizontal-negativo.svg')} alt="" width="130" height="30" />
        <img class="logo-claro" src={asset('logos/alphabytes-horizontal-color.svg')} alt="" width="130" height="30" />
      </a>
      <div class="escena__progreso" role="progressbar" aria-label="Progreso" aria-valuemin="0" aria-valuemax={total} aria-valuenow="0">
        <span data-barra></span>
      </div>
      <span class="escena__contador mono" data-contador hidden></span>
      <ThemeToggle />
      <a class="escena__salir" href={asset('')}>
        <Icon name="x" size={16} /><span>Salir</span>
      </a>
    </header>

    <div class="escena__cuerpo">
      <div class="pantalla pantalla--inicio" data-pantalla="inicio">
        <div class="asistente">
          <span class="asistente__avatar" aria-hidden="true">α</span>
          <p class="burbuja">¡Hola! 👋 Soy el asistente de AlphaBytes.</p>
        </div>
        <h1 id="ob-titulo" class="pantalla__titulo">Armemos tu proyecto <span class="acento">en 3 minutos</span></h1>
        <p class="pantalla__ayuda">
          No necesitas saber de tecnología. Te haré algunas preguntas, te sugeriré lo que mejor funciona para tu negocio y al
          final tendrás un resumen listo para enviarnos por WhatsApp.
        </p>
        <ul class="inicio__puntos">
          <li><span class="mono">01</span> Respondes con un clic</li>
          <li><span class="mono">02</span> Recibes recomendaciones</li>
          <li><span class="mono">03</span> Nos envías tu proyecto</li>
        </ul>
        <div class="pantalla__acciones">
          <button type="button" class="btn btn--indigo btn--grande" data-empezar>
            Empezar <Icon name="arrow" size={18} />
          </button>
          <span class="tecla-ayuda mono">o presiona <kbd>Enter ↵</kbd></span>
        </div>
      </div>

      <form class="pasos" id="onboarding" novalidate hidden>
        {PASOS.map((paso, i) => (
          <fieldset class="pantalla paso" data-paso={i} data-id={paso.id} hidden>
            <legend class="sr-only">{paso.titulo.replace('{nombre}, ', '')}</legend>
            <div class="asistente" aria-live="polite">
              <span class="asistente__avatar" aria-hidden="true">α</span>
              <p class="burbuja" data-burbuja>
                <span class="escribiendo" aria-hidden="true"><i></i><i></i><i></i></span>
              </p>
            </div>

            <h2 class="pantalla__titulo" tabindex="-1" data-titulo={paso.titulo}>{paso.titulo.replace('{nombre}, ', '')}</h2>
            <p class="pantalla__ayuda">{paso.ayuda}</p>

            {paso.tipo === 'nombre' && (
              <div class="campo-grande">
                <input name="nombre" type="text" autocomplete="given-name" placeholder="Escribe tu nombre" aria-label="Tu nombre" maxlength="60" />
                <span class="campo-grande__linea"></span>
              </div>
            )}

            {(paso.tipo === 'unica' || paso.tipo === 'multiple') && (
              <div class:list={['tarjetas', paso.opciones!.length > 6 && 'tarjetas--muchas', paso.opciones!.some((o) => o.valor) && 'tarjetas--valor', !paso.opciones!.some((o) => o.icono || o.valor) && 'tarjetas--chips']}>
                {paso.opciones!.map((o, n) => (
                  <label class="tarjeta" data-op={o.id} style={`--i: ${n}`}>
                    <input type={paso.tipo === 'unica' ? 'radio' : 'checkbox'} name={paso.id} value={o.id} />
                    <span class="tarjeta__caja">
                      {n < 9 && <kbd class="tarjeta__tecla" aria-hidden="true">{n + 1}</kbd>}
                      {o.icono && <span class="tarjeta__icono"><Icon name={o.icono} size={22} /></span>}
                      {o.valor && <span class="tarjeta__valor mono">{o.valor}</span>}
                      <span class="tarjeta__texto">
                        <span class="tarjeta__titulo">{o.texto}</span>
                        {o.detalle && <span class="tarjeta__detalle">{o.detalle}</span>}
                      </span>
                      <span class="tarjeta__check" aria-hidden="true"><Icon name="check" size={13} /></span>
                      <span class="tarjeta__sugerido mono">Sugerido</span>
                    </span>
                  </label>
                ))}
              </div>
            )}

            {paso.tipo === 'soluciones' && (
              <div class="soluciones">
                <div class="tarjetas tarjetas--soluciones">
                  {SOLUCIONES.map((s, n) => (
                    <label class="tarjeta tarjeta--solucion" data-op={s.id} style={`--i: ${n}`}>
                      <input type="checkbox" name="soluciones" value={s.id} />
                      <span class="tarjeta__caja">
                        <kbd class="tarjeta__tecla" aria-hidden="true">{n + 1}</kbd>
                        <span class="tarjeta__icono"><Icon name={s.icono!} size={22} /></span>
                        <span class="tarjeta__texto">
                          <span class="tarjeta__titulo">{s.texto}</span>
                          <span class="tarjeta__detalle">{s.detalle}</span>
                          <span class="tarjeta__motivo" data-motivo></span>
                        </span>
                        <span class="tarjeta__check" aria-hidden="true"><Icon name="check" size={13} /></span>
                        <span class="tarjeta__sugerido mono">Recomendado</span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            )}

            {paso.tipo === 'funciones' && (
              <div class="funciones">
                {SOLUCIONES.map((s) => (
                  <div class="funciones__grupo" data-solucion={s.id} hidden>
                    <p class="funciones__titulo mono"><Icon name={s.icono!} size={14} /> {s.texto}</p>
                    <div class="chips">
                      {s.funciones.map((f) => (
                        <label class="chip-op" data-op={f.id}>
                          <input type="checkbox" name="funciones" value={f.id} />
                          <span><Icon name="check" size={13} /> {f.texto}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {paso.tipo === 'presupuesto' && (
              <div class="rango">
                <output class="rango__valor" data-rango-valor>{PRESUPUESTOS_COTIZADOR[1].texto}</output>
                <input
                  type="range"
                  name="presupuesto-indice"
                  min="0"
                  max={PRESUPUESTOS_COTIZADOR.length - 1}
                  step="1"
                  value="1"
                  aria-label="Presupuesto aproximado"
                  aria-valuetext={PRESUPUESTOS_COTIZADOR[1].texto}
                />
                <div class="rango__marcas mono" aria-hidden="true">
                  {PRESUPUESTOS_COTIZADOR.map((p) => <span>{p.texto}</span>)}
                </div>
                <label class="rango__asesoria">
                  <input type="checkbox" name="asesoria" />
                  <span>No estoy seguro, prefiero que me asesoren</span>
                </label>
              </div>
            )}

            {paso.tipo === 'extras' && (
              <div class="extras">
                <div class="extras__fila">
                  <input name="empresa" type="text" autocomplete="organization" placeholder="Nombre de tu negocio (opcional)" aria-label="Nombre de tu negocio" />
                  <input name="ciudad" type="text" autocomplete="address-level2" placeholder="Ciudad (opcional)" aria-label="Ciudad" />
                </div>
                <textarea name="detalles" rows="4" placeholder="Cuéntanos cómo trabajas hoy, qué problema quieres resolver o cualquier idea que tengas." aria-label="Detalles adicionales"></textarea>
                <div class="chips chips--sugerencias">
                  {sugerenciasExtras.map((t) => (
                    <button type="button" class="chip-sugerencia" data-agregar={t}>+ {t}</button>
                  ))}
                </div>
              </div>
            )}

            <p class="paso__error" role="alert" data-error></p>
          </fieldset>
        ))}
      </form>

      <div class="pantalla pantalla--analizando" data-pantalla="analizando" hidden>
        <div class="analisis siempre-oscuro" aria-live="polite">
          <p class="analisis__cmd mono"><span>~$</span> alphabytes analizar --proyecto</p>
          <ol class="analisis__log mono" data-log></ol>
        </div>
      </div>

      <div class="pantalla pantalla--listo" data-pantalla="listo" hidden>
        <div class="confeti" aria-hidden="true" data-confeti></div>
        <div class="asistente">
          <span class="asistente__avatar" aria-hidden="true">α</span>
          <p class="burbuja" data-burbuja-final></p>
        </div>
        <h2 class="pantalla__titulo" tabindex="-1" data-titulo-final>Tu proyecto está listo</h2>

        <article class="resultado">
          <header class="resultado__cabecera">
            <p class="mono">proyecto.alphabytes</p>
            <span class="resultado__alcance" data-alcance></span>
          </header>
          <div class="resultado__soluciones" data-res-soluciones></div>
          <div class="resultado__bloque">
            <p class="resultado__etiqueta mono">Funciones</p>
            <div class="resultado__chips" data-res-funciones></div>
          </div>
          <dl class="resultado__datos" data-res-datos></dl>
          <div class="resultado__bloque">
            <p class="resultado__etiqueta mono">Stack sugerido</p>
            <div class="resultado__chips resultado__chips--stack" data-res-stack></div>
          </div>
        </article>

        <details class="mensaje">
          <summary><Icon name="whatsapp" size={16} /> Ver el mensaje que se enviará</summary>
          <pre class="mensaje__burbuja" data-mensaje></pre>
        </details>

        <div class="pantalla__acciones pantalla__acciones--final">
          <button type="button" class="btn btn--wa btn--grande" data-enviar>
            <Icon name="whatsapp" size={20} /> Enviar por WhatsApp
          </button>
          <button type="button" class="btn btn--borde" data-copiar>Copiar mensaje</button>
          <button type="button" class="enlace-sutil" data-revisar>Revisar mis respuestas</button>
        </div>
        <p class="pantalla__legal">
          Se abrirá WhatsApp con el mensaje listo; tú decides si lo envías. Usamos tus datos solo para preparar tu proforma ·
          <a href={asset('privacidad')}>Privacidad</a>
        </p>
      </div>
    </div>

    <footer class="escena__pie" data-pie hidden>
      <button type="button" class="btn btn--borde btn--sm" data-atras>
        <span aria-hidden="true">←</span> Atrás
      </button>
      <button type="button" class="enlace-sutil" data-omitir hidden>Omitir</button>
      <span class="tecla-ayuda mono">Enter ↵</span>
      <button type="button" class="btn btn--indigo" data-siguiente>
        Continuar <Icon name="arrow" size={18} />
      </button>
    </footer>
  </section>
</div>

<style>
  .ob {
    display: grid;
    min-height: 100dvh;
  }

  /* ---------- Lienzo lateral ---------- */
  .lienzo {
    position: relative;
    display: none;
    flex-direction: column;
    overflow: hidden;
    padding: 32px 40px;
    background:
      radial-gradient(circle at 50% 42%, rgb(91 75 255 / 0.28), transparent 55%),
      linear-gradient(to right, rgb(233 235 242 / 0.04) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(to bottom, rgb(233 235 242 / 0.04) 1px, transparent 1px) 0 0 / 48px 48px,
      var(--bg);
    color: var(--texto);
  }

  .lienzo__arriba img {
    height: 30px;
    width: auto;
  }

  .orbita {
    position: relative;
    width: min(340px, 80%);
    aspect-ratio: 1;
    margin: auto auto 0;
  }

  .orbita__anillo {
    position: absolute;
    inset: 0;
    border: 1px dashed rgb(233 235 242 / 0.14);
    border-radius: 50%;
    animation: girar 60s linear infinite;
  }

  .orbita__anillo--2 {
    inset: 22%;
    border-style: solid;
    border-color: rgb(233 235 242 / 0.08);
    animation-direction: reverse;
    animation-duration: 40s;
  }

  .orbita__centro {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    filter: drop-shadow(0 18px 40px rgb(91 75 255 / 0.6));
    animation: flotar 6s ease-in-out infinite;
  }

  .orbita__nodo {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    transform: rotate(var(--a)) translateY(-170%) rotate(calc(var(--a) * -1));
    transition: transform 0.6s var(--ease);
  }

  .orbita__nodo > span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border: 1px solid rgb(233 235 242 / 0.16);
    border-radius: 50%;
    background: rgb(16 22 42 / 0.8);
    color: var(--texto-2);
    backdrop-filter: blur(6px);
    transition:
      background-color 0.4s,
      color 0.4s,
      border-color 0.4s,
      box-shadow 0.4s,
      scale 0.4s var(--ease);
  }

  .orbita__nodo.recomendado > span {
    border-color: var(--indigo-claro);
    color: var(--titulo);
    box-shadow: 0 0 0 6px rgb(91 75 255 / 0.18);
  }

  .orbita__nodo.activo > span {
    border-color: var(--lima);
    background: var(--lima);
    color: var(--tinta);
    box-shadow: 0 0 0 8px rgb(198 244 50 / 0.15);
    scale: 1.12;
  }

  .lienzo__texto {
    margin-top: 40px;
  }

  .lienzo__paso {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lima);
  }

  .lienzo__titulo {
    margin-top: 10px;
    font-size: clamp(28px, 2.6vw, 38px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--titulo);
  }

  .construccion {
    min-height: 168px;
    margin: 28px 0 auto;
    padding: 16px 18px;
    border: 1px solid var(--borde);
    border-radius: 14px;
    background: rgb(11 15 26 / 0.7);
    font-size: 12.5px;
    line-height: 1.75;
    white-space: pre-wrap;
    color: var(--texto-2);
  }

  .construccion :global(.k) {
    color: #9a90ff;
  }

  .construccion :global(.s) {
    color: var(--lima);
  }

  .construccion :global(.nueva) {
    display: inline-block;
    animation: entrar-linea 0.6s var(--ease);
  }

  /* ---------- Escena ---------- */
  .escena {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: var(--bg);
  }

  .escena__barra {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
  }

  .escena__logo img {
    height: 26px;
    width: auto;
  }

  .logo-claro,
  :global([data-theme='light']) .logo-oscuro {
    display: none;
  }

  :global([data-theme='light']) .logo-claro {
    display: block;
  }

  .escena__progreso {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--bg-3);
    overflow: hidden;
  }

  .escena__progreso span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--indigo), var(--lima));
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .escena__contador {
    font-size: 12px;
    color: var(--texto-2);
  }

  .escena__salir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border: 1px solid var(--borde);
    border-radius: 9px;
    font-size: 13.5px;
    color: var(--texto-2);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .escena__salir:hover {
    border-color: var(--borde-fuerte);
    color: var(--titulo);
  }

  .escena__cuerpo {
    flex: 1;
    display: grid;
    align-items: center;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(24px, 5vh, 56px) clamp(16px, 4vw, 40px) 40px;
  }

  .pantalla {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .pantalla:not([hidden]) {
    animation: entrar-pantalla 0.55s var(--ease);
  }

  .pantalla.atras:not([hidden]) {
    animation-name: entrar-pantalla-atras;
  }

  .asistente {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }

  .asistente__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--indigo);
    font-family: var(--mono);
    font-weight: 500;
    color: var(--blanco);
    position: relative;
  }

  .asistente__avatar::after {
    content: '';
    position: absolute;
    top: -3px;
    right: -3px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--lima);
  }

  .burbuja {
    max-width: 520px;
    min-height: 40px;
    padding: 10px 14px;
    border: 1px solid var(--borde);
    border-radius: 14px 14px 14px 4px;
    background: var(--bg-2);
    font-size: 15px;
    line-height: 1.5;
    color: var(--texto);
  }

  .burbuja :global(.texto-burbuja) {
    animation: aparecer 0.4s var(--ease);
  }

  .escribiendo {
    display: inline-flex;
    gap: 4px;
    padding: 6px 2px;
  }

  .escribiendo i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--texto-3);
    animation: puntos 1s ease-in-out infinite;
  }

  .escribiendo i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .escribiendo i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .pantalla__titulo {
    margin-top: 28px;
    font-size: clamp(28px, 4.2vw, 44px);
    line-height: 1.06;
    letter-spacing: -0.04em;
    outline: none;
  }

  .pantalla__ayuda {
    margin-top: 12px;
    max-width: 580px;
    color: var(--texto-2);
    font-size: 16.5px;
  }

  .pantalla__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
  }

  .btn--grande {
    --alto: 56px;
    padding: 0 28px;
    font-size: 16.5px;
  }

  .tecla-ayuda {
    font-size: 12px;
    color: var(--texto-3);
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border: 1px solid var(--borde-fuerte);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--bg-2);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--texto-2);
  }

  .inicio__puntos {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  .inicio__puntos li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15.5px;
    color: var(--titulo);
    animation: aparecer 0.6s var(--ease) both;
  }

  .inicio__puntos li:nth-child(2) {
    animation-delay: 0.12s;
  }

  .inicio__puntos li:nth-child(3) {
    animation-delay: 0.24s;
  }

  .inicio__puntos .mono {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--bg-2);
    font-size: 12px;
    color: var(--acento);
  }

  /* ---------- Campo de nombre ---------- */
  .campo-grande {
    position: relative;
    margin-top: 32px;
  }

  .campo-grande input {
    width: 100%;
    padding: 8px 0 12px;
    border: 0;
    border-bottom: 2px solid var(--borde-fuerte);
    background: transparent;
