---
import Icon from './Icon.astro';
import { asset } from '../lib/url';

const lineas = [
  ['?', 'Tipo de negocio', 'Tienda o comercio'],
  ['?', '¿Qué quieres lograr?', 'Vender en línea, controlar inventario'],
  ['✓', 'Te recomendamos', 'Tienda en línea + Sistema a medida'],
  ['?', '¿Para cuándo?', 'En 1 a 3 meses'],
];
---

<section class="promo" id="arma-tu-proyecto" aria-labelledby="promo-titulo">
  <div class="contenedor">
    <div class="promo__caja revelar" data-foco>
      <div class="promo__texto">
        <p class="etiqueta">// Cotizador guiado</p>
        <h2 id="promo-titulo">¿Tienes una idea pero no sabes <span class="acento">qué necesitas</span>?</h2>
        <p>
          Responde unas preguntas con opciones, te sugerimos la solución adecuada y nos envías un resumen por WhatsApp.
          Así preparamos una proforma hecha para tu negocio.
        </p>
        <a class="btn btn--indigo" href={asset('cotizador')}>
          Armar mi proyecto <Icon name="arrow" size={18} />
        </a>
      </div>

      <div class="cli siempre-oscuro" aria-hidden="true">
        <p class="cli__cmd"><span>~$</span> npx crear-proyecto alphabytes</p>
        {lineas.map(([signo, pregunta, respuesta], i) => (
          <p class="cli__linea" style={`--n: ${i}`}>
            <span class:list={['cli__signo', signo === '✓' && 'cli__signo--ok']}>{signo}</span>
            <span class="cli__pregunta">{pregunta}</span>
            <span class="cli__respuesta">› {respuesta}</span>
          </p>
        ))}
        <p class="cli__fin" style={`--n: ${lineas.length}`}><span>→</span> Enviando resumen por WhatsApp…</p>
      </div>
    </div>
  </div>
</section>

<style>
  .promo {
    padding: 0 0 var(--seccion);
  }

  .promo__caja {
    display: grid;
    gap: 32px;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    background: var(--bg-2);
  }

  .promo h2 {
    margin-top: 16px;
    font-size: clamp(28px, 3.8vw, 42px);
    letter-spacing: -0.035em;
  }

  .promo__texto > p:not(.etiqueta) {
    margin-top: 14px;
    max-width: 480px;
    color: var(--texto-2);
  }

  .promo__texto .btn {
    margin-top: 28px;
  }

  .cli {
    align-self: center;
    padding: 20px 22px;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--bg);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.8;
    color: var(--texto);
    overflow: hidden;
  }

  .cli__cmd span,
  .cli__fin span {
    color: var(--lima);
  }

  .cli__cmd {
    margin-bottom: 10px;
    color: var(--titulo);
  }

  .cli__linea {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
  }

  .cli__signo {
    color: #9a90ff;
  }

  .cli__signo--ok {
    color: var(--lima);
  }

  .cli__pregunta {
    color: var(--titulo);
  }

  .cli__respuesta {
    width: 100%;
    padding-left: 20px;
    color: var(--texto-2);
  }

  .cli__fin {
    margin-top: 10px;
    color: var(--texto-2);
  }

  .js .cli__linea,
  .js .cli__fin {
    opacity: 0;
  }

  .js .promo__caja.visible .cli__linea,
  .js .promo__caja.visible .cli__fin {
    animation: aparecer-cli 0.5s var(--ease) both;
    animation-delay: calc(0.4s + var(--n) * 0.45s);
  }

  @keyframes aparecer-cli {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 480px) {
    .promo__texto .btn {
      width: 100%;
    }

    .cli {
      padding: 16px;
      font-size: 12px;
    }
  }

  @media (min-width: 1024px) {
    .promo__caja {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
    }
  }
</style>
