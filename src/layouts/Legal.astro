---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import WaButton from '../components/WaButton.astro';
import { asset } from '../lib/url';

interface Props {
  titulo: string;
  descripcion: string;
  archivo: string;
  actualizado: string;
  secciones: { id: string; titulo: string }[];
}

const { titulo, descripcion, archivo, actualizado, secciones } = Astro.props;
---

<Base titulo={`${titulo} | AlphaBytes`} descripcion={descripcion}>
  <Header />
  <main id="contenido">
    <header class="legal-cabecera">
      <div class="contenedor">
        <nav class="ruta revelar" aria-label="Ruta">
          <a href={asset('')}>~/alphabytes</a>
          <span>/</span>
          <span>legal</span>
          <span>/</span>
          <span class="ruta__actual" aria-current="page">{archivo}</span>
        </nav>
        <h1 class="revelar" style="--retraso: 0.08s">{titulo}</h1>
        <p class="legal-cabecera__desc revelar" style="--retraso: 0.14s">{descripcion}</p>
        <p class="legal-cabecera__meta revelar" style="--retraso: 0.2s">
          <span>Última actualización</span>
          <time>{actualizado}</time>
        </p>
      </div>
    </header>

    <div class="contenedor legal">
      <aside class="indice">
        <p class="indice__titulo">Contenido</p>
        <ol>
          {secciones.map((s, i) => (
            <li>
              <a href={`#${s.id}`} data-indice={s.id}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {s.titulo}
              </a>
            </li>
          ))}
        </ol>
      </aside>

      <article class="prosa">
        <slot />

        <div class="legal-contacto">
          <p>¿Tienes dudas sobre este documento?</p>
          <WaButton clave="general" tam="sm">Escríbenos</WaButton>
        </div>
      </article>
    </div>
  </main>
  <Footer />
  <WhatsAppWidget />
</Base>

<style>
  .legal-cabecera {
    position: relative;
    padding: clamp(48px, 7vw, 88px) 0 clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--borde);
    background:
      linear-gradient(to right, var(--rejilla) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(to bottom, var(--rejilla) 1px, transparent 1px) 0 0 / 64px 64px;
  }

  .ruta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--texto-3);
  }

  .ruta a {
    color: var(--acento);
  }

  .ruta a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ruta__actual {
    color: var(--titulo);
  }

  .legal-cabecera h1 {
    margin-top: 20px;
    font-size: clamp(36px, 5.4vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .legal-cabecera__desc {
    max-width: 640px;
    margin-top: 16px;
    color: var(--texto-2);
    font-size: 17.5px;
  }

  .legal-cabecera__meta {
    display: inline-flex;
    gap: 10px;
    margin-top: 24px;
    padding: 6px 12px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--bg-2);
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--texto-2);
  }

  .legal-cabecera__meta time {
    color: var(--titulo);
  }

  .legal {
    display: grid;
    gap: 40px;
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: var(--seccion);
  }

  .indice {
    padding: 20px;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--bg-2);
  }

  .indice__titulo {
    margin-bottom: 12px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texto-3);
  }

  .indice ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .indice a {
    display: flex;
    gap: 10px;
    padding: 6px 10px;
    border-left: 1px solid var(--borde);
    font-size: 14px;
    color: var(--texto-2);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }

  .indice a span {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--texto-3);
    padding-top: 2px;
  }

  .indice a:hover,
  .indice a.activo {
    border-color: var(--acento);
    color: var(--titulo);
  }

  .indice a.activo {
    background: var(--bg-3);
  }

  .prosa {
    min-width: 0;
    max-width: 760px;
    color: var(--texto);
    font-size: 16.5px;
  }

  .prosa :global(section) {
    scroll-margin-top: calc(var(--header) + 24px);
  }

  .prosa :global(section:first-of-type) {
    margin-top: 40px;
  }

  .prosa :global(section + section) {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--borde);
  }

  .prosa :global(h2) {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: clamp(22px, 2.6vw, 26px);
  }

  .prosa :global(h2 .num) {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--acento);
  }

  .prosa :global(h3) {
    margin-top: 24px;
    font-size: 17.5px;
  }

  .prosa :global(p),
  .prosa :global(ul),
  .prosa :global(table) {
    margin-top: 14px;
  }

  .prosa :global(ul) {
    display: grid;
    gap: 8px;
  }

  .prosa :global(ul li) {
    position: relative;
    padding-left: 20px;
  }

  .prosa :global(ul li::before) {
    content: '';
    position: absolute;
    top: 0.68em;
    left: 2px;
    width: 6px;
    height: 6px;
    border-radius: 1.5px;
    background: var(--lima);
  }

  .prosa :global(strong) {
    color: var(--titulo);
    font-weight: 600;
  }

  .prosa :global(a:not(.btn)) {
    color: var(--acento);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prosa :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--bg-3);
    font-family: var(--mono);
    font-size: 0.88em;
  }

  .prosa :global(.tabla) {
    overflow-x: auto;
    margin-top: 16px;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }

  .prosa :global(table) {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prosa :global(th),
  .prosa :global(td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--borde);
    text-align: left;
    vertical-align: top;
  }

  .prosa :global(tr:last-child td) {
    border-bottom: 0;
  }

  .prosa :global(th) {
    background: var(--bg-2);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-2);
  }

  .prosa :global(.nota) {
    padding: 14px 16px;
    border: 1px solid var(--borde);
    border-left: 3px solid var(--acento);
    border-radius: 10px;
    background: var(--bg-2);
    font-size: 15px;
  }

  .legal-contacto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding: 20px 24px;
    border: 1px dashed var(--borde-fuerte);
    border-radius: var(--radio);
  }

  .legal-contacto p {
    font-weight: 500;
    color: var(--titulo);
  }

  @media (min-width: 1024px) {
    .legal {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }

    .indice {
      position: sticky;
      top: calc(var(--header) + 24px);
    }
  }
</style>

<script>
  const enlaces = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-indice]')].map((a) => [a.dataset.indice, a]),
  );
  const observador = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        enlaces.forEach((a) => a.classList.remove('activo'));
        enlaces.get(e.target.id)?.classList.add('activo');
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  document.querySelectorAll('.prosa section[id]').forEach((s) => observador.observe(s));
</script>
