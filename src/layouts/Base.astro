---
import '@fontsource-variable/geist';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/global.css';
import { SITE, REDES, SERVICIOS_SOFTWARE, SERVICIOS_TI } from '../data/site';
import { asset } from '../lib/url';
import BrandSprite from '../components/BrandSprite.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  inicio?: boolean;
}

const { titulo = SITE.titulo, descripcion = SITE.descripcion, inicio = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(asset('og-image-1200x630.png'), Astro.site).href;
const logo = new URL(asset('android-chrome-512x512.png'), Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.nombre,
  description: SITE.descripcion,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  logo,
  image: ogImage,
  telephone: SITE.whatsappVisible.replace(/\s/g, ''),
  email: SITE.correo,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.ciudad,
    addressRegion: SITE.provincia,
    addressCountry: 'EC',
  },
  areaServed: { '@type': 'Country', name: SITE.pais },
  openingHours: SITE.horarioSchema,
  sameAs: Object.values(REDES).filter(Boolean),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de tecnología',
    itemListElement: [...SERVICIOS_SOFTWARE, ...SERVICIOS_TI].map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.titulo, description: s.resumen },
    })),
  },
};
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta
      name="keywords"
      content="desarrollo web, aplicaciones móviles, software a medida, mantenimiento de computadoras, auditoría informática, redes, Jipijapa, Manabí, Ecuador"
    />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B0F1A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F7FB" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" href={asset('favicon.ico')} sizes="48x48" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AlphaBytes · Desarrollo de software" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (() => {
        const d = document.documentElement;
        let pref = 'auto';
        try {
          pref = localStorage.getItem('tema') || 'auto';
        } catch {}
        const oscuro = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
        d.dataset.theme = oscuro ? 'dark' : 'light';
        d.dataset.temaPref = pref;
        d.classList.add('js');
      })();
    </script>
    {inicio && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <BrandSprite />
    <div class="progreso" aria-hidden="true"></div>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>

<script>
  import '../scripts/whatsapp';
  import '../scripts/animaciones';
</script>
