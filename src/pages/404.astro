---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaButton from '../components/WaButton.astro';
import Icon from '../components/Icon.astro';
import { asset } from '../lib/url';
---

<Base titulo="Página no encontrada | AlphaBytes" descripcion="La página que buscas no existe o fue movida.">
  <Header />
  <main id="contenido" class="error">
    <div class="contenedor error__fila">
      <div class="terminal siempre-oscuro revelar" aria-hidden="true">
        <div class="terminal__barra"><i></i><i></i><i></i><span>bash — alphabytes</span></div>
        <pre><span class="p">~$</span> curl -I alphabytes{'\n'}<span class="e">HTTP/2 404 Not Found</span>{'\n'}<span class="p">~$</span> git log --oneline -- esta-pagina{'\n'}<span class="c">fatal: la ruta no existe en ninguna rama</span>{'\n'}<span class="p">~$</span> cd ~/inicio<span class="cursor"></span></pre>
      </div>
      <div class="error__texto revelar" style="--retraso: 0.1s">
        <p class="etiqueta">// Error 404</p>
        <h1>Esta página no existe <span class="acento">(todavía)</span></h1>
        <p>Puede que el enlace esté mal escrito o que la página se haya movido. Vuelve al inicio o escríbenos si buscabas algo en particular.</p>
        <div class="error__botones">
          <a class="btn btn--indigo" href={asset('')}><Icon name="arrow" size={18} /> Volver al inicio</a>
          <WaButton clave="general" variante="borde">Escríbenos</WaButton>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .error {
    padding: clamp(56px, 9vw, 120px) 0;
  }

  .error__fila {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .terminal {
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    background: var(--bg-2);
    box-shadow: var(--sombra);
  }

  .terminal__barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--borde);
    background: var(--bg);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--texto-3);
  }

  .terminal__barra i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--borde-fuerte);
  }

  .terminal__barra i:first-child {
    background: var(--indigo);
  }

  .terminal__barra i:nth-child(2) {
    background: var(--lima);
  }

  .terminal__barra span {
    margin-left: 10px;
  }

  pre {
    margin: 0;
    padding: 22px 20px 26px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--texto);
  }

  .p {
    color: var(--lima);
  }

  .e {
    color: #fca5a5;
  }

  .c {
    color: var(--texto-3);
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    margin-left: 4px;
    vertical-align: -3px;
    background: var(--lima);
    animation: parpadeo 1.1s steps(1) infinite;
  }

  .error h1 {
    margin-top: 16px;
    font-size: clamp(34px, 5vw, 56px);
    letter-spacing: -0.04em;
  }

  .error__texto > p:not(.etiqueta) {
    margin-top: 16px;
    max-width: 480px;
    color: var(--texto-2);
  }

  .error__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 1024px) {
    .error__fila {
      grid-template-columns: 1fr 1fr;
      gap: 72px;
    }
  }
</style>
