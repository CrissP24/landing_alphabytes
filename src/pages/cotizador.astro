---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cotizador from '../components/Cotizador.astro';
import { asset } from '../lib/url';
---

<Base
  titulo="Arma tu proyecto | Cotizador AlphaBytes"
  descripcion="Responde unas preguntas sencillas y recibe una proforma a la medida de tu negocio: web, app, sistema a medida o soporte técnico."
>
  <Header />
  <main id="contenido">
    <header class="intro">
      <div class="contenedor">
        <nav class="ruta revelar" aria-label="Ruta">
          <a href={asset('')}>~/alphabytes</a><span>/</span><span aria-current="page">cotizador</span>
        </nav>
        <h1 class="revelar" style="--retraso: 0.06s">Arma tu proyecto <span class="acento">paso a paso</span></h1>
        <p class="revelar" style="--retraso: 0.12s">
          ¿Tienes una idea pero no sabes exactamente qué necesitas? Responde unas preguntas, te sugerimos opciones y al final
          nos envías un resumen por WhatsApp para prepararte una proforma a tu medida.
        </p>
        <ul class="intro__datos revelar" style="--retraso: 0.18s">
          <li><span class="mono">~3 min</span> para completarlo</li>
          <li><span class="mono">0</span> registros ni contraseñas</li>
          <li><span class="mono">100%</span> gratis y sin compromiso</li>
        </ul>
      </div>
    </header>

    <section class="contenedor cuerpo" aria-label="Cotizador">
      <Cotizador />
    </section>
  </main>
  <Footer />
</Base>

<style>
  .intro {
    padding: clamp(40px, 6vw, 72px) 0 clamp(28px, 4vw, 40px);
    background:
      linear-gradient(to right, var(--rejilla) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(to bottom, var(--rejilla) 1px, transparent 1px) 0 0 / 64px 64px;
  }

  .ruta {
    display: flex;
    gap: 6px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--texto-3);
  }

  .ruta a {
    color: var(--acento);
  }

  .ruta span[aria-current] {
    color: var(--titulo);
  }

  .intro h1 {
    margin-top: 18px;
    font-size: clamp(36px, 5.4vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .intro p {
    max-width: 640px;
    margin-top: 16px;
    color: var(--texto-2);
    font-size: 17.5px;
  }

  .intro__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .intro__datos li {
    display: inline-flex;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--borde);
    border-radius: 8px;
    background: var(--bg-2);
    font-size: 14px;
    color: var(--texto-2);
  }

  .intro__datos .mono {
    color: var(--acento);
  }

  .cuerpo {
    padding-bottom: var(--seccion);
  }
</style>
